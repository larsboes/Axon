#!/bin/bash
# axon — the public command interface for an Axon installation.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  case "$TARGET" in
    /*) SOURCE="$TARGET" ;;
    *) SOURCE="$DIR/$TARGET" ;;
  esac
done
AXON_ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Where to poll a capability and what the answer means. In a library because none of it can
# be tested through this CLI on a machine with no services running, and CI has none —
# tools/capability-probe.test.sh drives the rules directly.
# shellcheck source=tools/lib/capability-probe.sh
. "$AXON_ROOT/tools/lib/capability-probe.sh"

usage() {
  cat <<'EOF'
Usage: axon <command> [arguments]

Discover Axon:
  help [command]                 Show commands or one command's usage
  search <words...>              Search commands, capabilities, and Packs
  doctor                          Check this Axon installation
  context with [capability]      Emit bounded current operating context
  context on [unit-or-path]      Emit bounded current repository context
  storage <report|apply|target|prune>
                                 What is filling this disk, and what is safe to reclaim

Check a change before pushing it:
  gates                          Run CI's repo gates here, from CI's own definition
  test                           Run CI's bun test and every tools/*.test.sh
  cargo <args...>                Run cargo against a scratch target dir and a scratch overlay

Operate capabilities:
  capability list                List registered HTTP capability surfaces and health
  capability health              Probe registered capability health endpoints
  capability url <capability>    Print a registered capability's HTTP base URL
  capability call <name> <get|post|put|patch|delete> <path> [body] [curl-args...]
  capability ingest <url>        Ingest a URL through comms
  capability feed [days]         Read the comms feed

Manage Packs:
  pack list [harness]            List available Packs, optionally for one harness
  pack status <harness> [pack|--all]
  pack deploy <harness> <pack>...
  pack sync <harness> <pack|--all>
  pack remove <harness> <pack>...

Run 'axon help <command>' for focused help.
EOF
}

help() {
  case "${1:-}" in
    "") usage ;;
    capability) cat <<'EOF'
Usage: axon capability <command>

  list | health | url <capability>
  call <name> <get|post|put|patch|delete> <path> [body] [curl-args...]
  ingest <url> | feed [days]

health polls each capability's ready_path where it declares one and its health_path
otherwise, which is what axon-status judges availability on. Four states:

  up       answered 200
  down     declares autostart and did not answer. The only state that exits non-zero
  off      declares autostart = "false", so not running is its own declaration
  unknown  declares neither a health nor a ready path; nothing can answer for it

An external capability is polled at its resolved endpoint, not on loopback: it has no
port here because a port is a fact about the host that binds it.
EOF
      ;;
    pack) cat <<'EOF'
Usage: axon pack <command> <harness> ...

Harnesses: claude, codex, opencode, pi
Commands: list [harness], status, deploy, sync, remove
EOF
      ;;
    context) echo "Usage: axon context with [capability] | on [unit-or-path]" ;;
    storage) cat <<'EOF'
Usage: axon storage <command>

  report [--json]   free/used/total, every policy class, what is flagged
  apply  [--json]   run each applicable class's reclaim command
  target [--json]   the Cargo target dir against PRD §9's R6 debug/release ratio
  prune [--incremental] [--target] [--node-modules] [--dry-run]

Policy: <overlay>/config/storage-policy.toml. See tools/storage/README.md.
EOF
      ;;
    gates|test) cat <<'EOF'
Usage: axon gates | axon test

Both replay one job of .github/workflows/ci.yml here, reading the step list out of that
file. No gate is named here on purpose: a second copy of the list is a copy that goes
stale, so `tools/ci-local list` prints what each job will actually run.

  gates   the repo-gates job — the file-based checks, in CI's order
  test    the bun-tests job — `bun test` from the root, then every tools/*.test.sh

Every step runs even after one fails. Exit 1 means a step failed.
Rust is deliberately not here: run `axon cargo test --workspace --locked`.
`tools/ci-local list` also says why CI's remaining jobs are refused on this machine.
EOF
      ;;
    cargo) cat <<'EOF'
Usage: axon cargo <args...>

cargo, with the four things a run on this machine has to be protected from:

  a scratch CARGO_TARGET_DIR   the repository's target/release/<bin> IS the binary a
                               live service is running, and replacing it kills it
  --release refused            for the same reason
  a scratch overlay            AXON_* is cleared, then pointed at a throwaway root
  scratch projection roots     trips, finance, interior and comms export notes into
                               the Obsidian vault from roots AXON_DB_PATH never touches

  --print-env    show the environment it would use, and run nothing

Set CARGO_TARGET_DIR yourself to reuse a warm one; anything inside the repository
is refused.
EOF
      ;;
    doctor|search) echo "Usage: axon $1 ${1#doctor}" | sed 's/ $//' ;;
    *) echo "axon: no help for '$1'" >&2; exit 1 ;;
  esac
}

capability_rows() {
  "$AXON_ROOT/tools/capability.sh" registry |
    jq -r --arg fs "$CAPABILITY_FS" \
      '.[] | select(.port != "" or .endpoint != "")
           | [.name, .scope, .port, .endpoint, (.health_path // ""), (.ready_path // ""), (.autostart // "")]
           | join($fs)'
}

# An external capability answers here too. Its port is blank by construction — a port is a
# fact about the host that binds it, and this machine does not — so a lookup keyed on `.port`
# reported "no registered HTTP surface" for a capability that has one, on another host, and
# whose base URL the registry had already resolved.
capability_url() {
  local name="$1" row scope port endpoint url
  row="$("$AXON_ROOT/tools/capability.sh" registry |
    jq -r --arg name "$name" --arg fs "$CAPABILITY_FS" \
      '.[] | select(.name == $name) | [.scope, .port, .endpoint] | join($fs)' | head -n 1)"
  IFS="$CAPABILITY_FS" read -r scope port endpoint <<EOF
$row
EOF
  url="$(capability_base_url "${scope:-}" "${port:-}" "${endpoint:-}")"
  [ -n "$url" ] && [ "$url" != "http://127.0.0.1:" ] ||
    { echo "axon: capability '$name' has no registered HTTP surface" >&2; exit 1; }
  echo "$url"
}

capability_list() {
  while IFS="$CAPABILITY_FS" read -r name scope port endpoint health_path ready_path autostart; do
    local url probe state
    url="$(capability_base_url "$scope" "$port" "$endpoint")"
    probe="$(capability_probe_url "$scope" "$port" "$endpoint" "$health_path" "$ready_path")"
    if [ -z "$probe" ]; then
      state="unknown"
    else
      state="$(capability_state "$(capability_probe_code "$probe")" "$autostart")"
    fi
    printf '%-18s %-38s %s\n' "$name" "$url" "$state"
  done < <(capability_rows)
}

capability_health() {
  local failed=0 any=0
  while IFS="$CAPABILITY_FS" read -r name scope port endpoint health_path ready_path autostart; do
    local probe code state
    probe="$(capability_probe_url "$scope" "$port" "$endpoint" "$health_path" "$ready_path")"
    # Reported, not skipped. A capability with no probe path is a capability nothing can
    # answer for, and dropping the row said the same thing as a clean bill of health.
    if [ -z "$probe" ]; then
      printf 'unknown %-18s %s\n' "$name" "— no health or ready path to poll"
      continue
    fi
    any=1
    code="$(capability_probe_code "$probe")"
    state="$(capability_state "$code" "$autostart")"
    case "$state" in
      up)   printf 'up      %-18s %s\n' "$name" "$probe" ;;
      down) printf 'down    %-18s %s  HTTP %s\n' "$name" "$probe" "${code:-unreachable}"; failed=1 ;;
      off)  printf 'off     %-18s %s  not autostarted; start it with tools/service-runner.sh start %s\n' \
              "$name" "$probe" "$name" ;;
    esac
  done < <(capability_rows)
  # An empty sweep is a broken registry, not a healthy machine — the same guard
  # tools/check-store-transactions.sh keeps on its own input.
  if [ "$any" -eq 0 ]; then
    echo "axon: no capability had anything to probe — the registry is empty or unreadable" >&2
    return 1
  fi
  echo
  echo "down = declares autostart and is not answering. off = declares autostart=false, so"
  echo "not running is its own declaration, not a fault. Only 'down' sets a non-zero exit."
  return "$failed"
}

# `--fail-with-body`, not `-f`: a capability that rejects a write puts the reason in the
# response body, and `-f` throws that body away before the caller ever sees it. A caller
# then gets exit 22 and no way to learn which field was wrong, which is the opposite of
# what the capability went to the trouble of writing. The non-zero exit is unchanged.
# Needs curl >= 7.76 (2021); macOS ships 8.x.
#
# PUT, PATCH and DELETE are here because capabilities serve them: trips alone has
# `PATCH /api/plans/:id` and two DELETE routes, and calendar's idempotent upsert is
# `PUT /api/entries/external`. Without these arms, half of a capability's own lifecycle
# is unreachable through the one sanctioned non-browser transport.
capability_call() {
  local name="$1" method="$2" path="$3"
  shift 3
  local base verb
  base="$(capability_url "$name")"
  verb="$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')"
  case "$method" in
    get) curl -s --fail-with-body "$base$path" "$@" ;;
    delete) curl -s --fail-with-body -X DELETE "$base$path" "$@" ;;
    post|put|patch)
      local body="${1:-}"
      [ "$#" -eq 0 ] || shift
      curl -s --fail-with-body -X "$verb" "$base$path" \
        -H 'Content-Type: application/json' -d "$body" "$@"
      ;;
    *) echo "axon: method must be one of get, post, put, patch, delete" >&2; exit 1 ;;
  esac
}

capability_command() {
  local command="${1:-list}"
  shift || true
  case "$command" in
    list) capability_list ;;
    health|status) capability_health ;;
    url) [ "$#" -eq 1 ] || { echo "usage: axon capability url <capability>" >&2; exit 1; }; capability_url "$1" ;;
    call) [ "$#" -ge 3 ] || { echo "usage: axon capability call <name> <get|post|put|patch|delete> <path> [body] [curl-args...]" >&2; exit 1; }; capability_call "$@" ;;
    ingest)
      [ "$#" -eq 1 ] || { echo "usage: axon capability ingest <url>" >&2; exit 1; }
      capability_call comms post /ingest "$(jq -nc --arg url "$1" '{url:$url}')"
      ;;
    feed)
      local days="${1:-7}"
      case "$days" in *[!0-9]*|'') echo "axon: days must be a positive integer" >&2; exit 1 ;; esac
      capability_call comms get "/feed?days=$days"
      ;;
    *) echo "usage: axon capability {list|health|url|call|ingest|feed}" >&2; exit 1 ;;
  esac
}

pack_command() {
  local command="${1:-}" harness="${2:-}"
  shift 2 2>/dev/null || true
  case "$command" in
    list)
      case "$harness" in
        "") bun run "$AXON_ROOT/tools/packs-opencode.ts" list ;;
        claude) bun run "$AXON_ROOT/tools/packs-claude.ts" status ;;
        codex) "$AXON_ROOT/tools/packs-codex" status --all ;;
        opencode) bun run "$AXON_ROOT/tools/packs-opencode.ts" list ;;
        pi) bun run "$AXON_ROOT/tools/packs-pi.ts" list ;;
        *) echo "axon: unknown harness '$harness'" >&2; exit 1 ;;
      esac
      ;;
    status|deploy|sync|remove)
      [ -n "$harness" ] || { echo "usage: axon pack $command <harness> ..." >&2; exit 1; }
      case "$harness" in
        # First-class since 2026-08-09: the Claude adapter deploys copies with a
        # ledger like every other harness, so status/deploy/sync/remove all mean
        # something here. It used to accept status alone, because symlinking had
        # no sync and no ownership to remove against.
        claude) bun run "$AXON_ROOT/tools/packs-claude.ts" "$command" "$@" ;;
        codex) "$AXON_ROOT/tools/packs-codex" "$command" "$@" ;;
        opencode) bun run "$AXON_ROOT/tools/packs-opencode.ts" "$command" "$@" ;;
        pi) bun run "$AXON_ROOT/tools/packs-pi.ts" "$command" "$@" ;;
        *) echo "axon: unknown harness '$harness'" >&2; exit 1 ;;
      esac
      ;;
    *) echo "usage: axon pack {list|status|deploy|sync|remove} ..." >&2; exit 1 ;;
  esac
}

search() {
  [ "$#" -gt 0 ] || { echo "usage: axon search <words...>" >&2; exit 1; }
  local query="$*" lowered
  lowered="$(printf '%s' "$query" | tr '[:upper:]' '[:lower:]')"
  echo "Commands:"
  usage | grep -iF "$query" || true
  echo
  echo "Capabilities:"
  "$AXON_ROOT/tools/capability.sh" registry | jq -r '.[] | [.name, (.kind // "")] | @tsv' | grep -iF "$lowered" || true
  echo
  echo "Packs:"
  bun run "$AXON_ROOT/tools/packs-opencode.ts" list | grep -iF "$lowered" || true
}

case "${1:-help}" in
  help) shift; help "${1:-}" ;;
  -h|--help) usage ;;
  search) shift; search "$@" ;;
  doctor) shift; exec "$AXON_ROOT/tools/doctor" "$@" ;;
  context) shift; exec "$AXON_ROOT/tools/axon-context" "$@" ;;
  # Same delegation as doctor: the launcher owns the overlay resolution and the lazy
  # release build, so there is one implementation of both.
  storage) shift; exec "$AXON_ROOT/tools/storage/storage" "$@" ;;
  # Same delegation again, and the job names are CI's own. `gates` and `test` are two
  # jobs of one workflow, not two tools: tools/ci-local reads the step list out of
  # .github/workflows/ci.yml so neither verb can drift from what the push will run.
  gates) shift; exec "$AXON_ROOT/tools/ci-local" run repo-gates "$@" ;;
  test) shift; exec "$AXON_ROOT/tools/ci-local" run bun-tests "$@" ;;
  cargo) shift; exec "$AXON_ROOT/tools/cargo-hermetic" "$@" ;;
  capability) shift; capability_command "$@" ;;
  pack) shift; pack_command "$@" ;;
  *) echo "axon: unknown command '$1'" >&2; echo "Run 'axon help'." >&2; exit 1 ;;
esac
