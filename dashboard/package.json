{
  "name": "@axon/dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Axon — the spine's shell: what is enabled on this machine, what it is saying, and what starts on demand.",
  "overrides": {
    "cookie": "0.7.2"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./svelte.config.js && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./svelte.config.js"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.0.0",
    "maplibre-gl": "5.21.1",
    "mermaid": "11.16.1",
    "svelte": "^5.0.0",
    "vega": "6.2.0",
    "vega-embed": "7.1.0",
    "vega-lite": "6.4.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^24.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  }
}
