{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "roomplan:default",
    "foundation-models:default",
    "local-network:default",
    "notification:default",
    "allow-mac-request",
    "allow-mac-request-bytes",
    "allow-connection-settings-get",
    "allow-connection-settings-set",
    "allow-connection-local-set",
    "allow-sync-status",
    "allow-sync-entries",
    "allow-sync-flush",
    "allow-sync-resolve",
    "allow-device-identity-get",
    "allow-device-identity-reset"
  ]
}
