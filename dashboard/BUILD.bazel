load("//tools/bazel/bun:build.bzl", "bun_vite_build")

# package.json and bun.lock are read by //tools/bazel/bun:deps.bzl at fetch time,
# which needs them visible as plain source files. README.md and service.toml are
# data for //:generate_architecture -- once this directory became its own package,
# the root's glob could no longer reach them and needs explicit labels instead.
exports_files([
    "package.json",
    "bun.lock",
    "README.md",
    "service.toml",
])

# The spine's shell (README.md#three-architectural-nouns), and the one root-level app. It is in the
# build graph for the same reason the capability UIs are: `dist/` is what a server
# hands out, and a served artifact should be reproducible rather than whatever the
# last local `bun run build` happened to produce.
#
# This does not change how the shell is developed. `service.toml` still supervises
# `bun run dev`, because Vite's dev server IS the hot reload; Bazel owns the built
# bundle, which is what a machine with nobody editing on it serves. See README.md.
bun_vite_build(
    name = "bundle",
    srcs = glob(
        [
            "src/**",
            "static/**",
            "vite/**",
        ],
        exclude = ["vite/**/*.test.ts"],
        allow_empty = True,
    ) + [
        "package.json",
        "svelte.config.js",
        "tsconfig.json",
        "vite.config.ts",
    ],
    node_modules = "@dashboard_deps//:node_modules",
    visibility = ["//visibility:public"],
)
