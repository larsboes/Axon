#!/bin/bash
# Emit bounded, current context for one Axon operating or repository target.
set -eu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
AXON_SKILL_ROOT="$($SCRIPT_DIR/axon-root)"
mode="${1:-}"
target="${2:-}"

usage() {
  echo "usage: axon-context with [capability] | on [unit-or-path]" >&2
  exit 1
}

print_path_if_present() {
  if [ -e "$AXON_SKILL_ROOT/$1" ]; then
    echo "read=$1"
  fi
  return 0
}

context_with() {
  registry="$($AXON_SKILL_ROOT/tools/capability.sh registry)"
  echo "mode=with"
  echo "repo=$AXON_SKILL_ROOT"
  if [ -z "$target" ]; then
    echo "capabilities:"
    printf '%s\n' "$registry" | jq -r '.[] | "  \(.name)\tkind=\(.kind)\thttp=\(if .port == "" then "none" else "registered" end)"'
    echo "next=scripts/axapi list"
    return
  fi
  row="$(printf '%s\n' "$registry" | jq -c --arg name "$target" '.[] | select(.name == $name)' | head -n 1)"
  if [ -z "$row" ]; then
    echo "axon-context: unknown capability '$target'" >&2
    printf '%s\n' "$registry" | jq -r '.[].name' >&2
    exit 1
  fi
  echo "target=$target"
  echo "registry=$row"
  print_path_if_present "capabilities/$target/README.md"
  print_path_if_present "capabilities/$target/service.toml"
  echo "next=scripts/axapi url $target"
}

unit_from_target() {
  case "$1" in
    capabilities/*|libs/*|Packs/*) printf '%s\n' "$1" | cut -d/ -f2 ;;
    dashboard/*|tools/*|schemas/*) printf '%s\n' "$1" | cut -d/ -f1 ;;
    *) echo "$1" ;;
  esac
}

context_on() {
  echo "mode=on"
  echo "repo=$AXON_SKILL_ROOT"
  git -C "$AXON_SKILL_ROOT" status --short --branch
  if [ -z "$target" ]; then
    "$AXON_SKILL_ROOT/tools/self" status
    echo "read=README.md"
    echo "next=tools/doctor"
    return
  fi

  normalized="${target#./}"
  if [ -e "$AXON_SKILL_ROOT/$normalized" ]; then
    unit="$(unit_from_target "$normalized")"
    echo "target=$normalized"
  else
    unit="$target"
    echo "target=$target"
  fi

  "$AXON_SKILL_ROOT/tools/self" explain "$unit" --json 2>/dev/null || echo "self=unavailable-for-$unit"
  print_path_if_present "capabilities/$unit/README.md"
  print_path_if_present "capabilities/$unit/service.toml"
  print_path_if_present "capabilities/$unit/BUILD.bazel"
  print_path_if_present "libs/$unit/README.md"
  print_path_if_present "libs/$unit/BUILD.bazel"
  print_path_if_present "Packs/$unit/README.md"
  print_path_if_present "Packs/$unit/pack.toml"
  print_path_if_present "$normalized"
  echo "next=tools/doctor"
}

case "$mode" in
  with) context_with ;;
  on) context_on ;;
  *) usage ;;
esac
