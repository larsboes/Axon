#!/bin/bash
# Discover and call Axon capabilities through the live registry.
set -eu

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
AXON_SKILL_ROOT="$($SCRIPT_DIR/axon-root)"
REGISTRY=""

read_registry() {
  if [ -z "$REGISTRY" ]; then
    REGISTRY="$($AXON_SKILL_ROOT/tools/capability.sh registry)"
  fi
  printf '%s\n' "$REGISTRY"
}

registry_rows() {
  read_registry | jq -r '.[] | select(.port != "") | [.name, .port, (.health_path // ""), (.health_url // "")] | @tsv'
}

cmd_list() {
  registry_rows | while IFS="$(printf '\t')" read -r name port health_path health_url; do
    url="http://127.0.0.1:$port"
    probe="$health_url"
    [ -n "$probe" ] || probe="$url$health_path"
    if [ -z "$health_path$health_url" ]; then
      state="unknown"
    elif [ "$(curl -sf -o /dev/null -w '%{http_code}' "$probe" 2>/dev/null || true)" = "200" ]; then
      state="up"
    else
      state="down"
    fi
    printf '%-18s %-30s %s\n' "$name" "$url" "$state"
  done
}

cmd_url() {
  name="$1"
  port="$(read_registry | jq -r --arg name "$name" '.[] | select(.name == $name and .port != "") | .port' | head -n 1)"
  if [ -z "$port" ]; then
    echo "axapi: capability '$name' has no registered HTTP surface" >&2
    exit 1
  fi
  echo "http://127.0.0.1:$port"
}

cmd_health() {
  failed=0
  while IFS="$(printf '\t')" read -r name port health_path health_url; do
    [ -n "$health_path$health_url" ] || continue
    url="$health_url"
    [ -n "$url" ] || url="http://127.0.0.1:$port$health_path"
    code="$(curl -sf -o /dev/null -w '%{http_code}' "$url" 2>/dev/null || true)"
    if [ "$code" = "200" ]; then
      echo "up    $name  $url"
    else
      echo "down  $name  $url  HTTP ${code:-unreachable}"
      failed=1
    fi
  done < <(registry_rows)
  return "$failed"
}

cmd_call() {
  name="$1"
  method="$2"
  path="$3"
  shift 3
  base="$(cmd_url "$name")"
  case "$method" in
    get) curl -sf "$base$path" "$@" ;;
    post)
      body="${1:-}"
      [ "$#" -eq 0 ] || shift
      curl -sf -X POST "$base$path" -H 'Content-Type: application/json' -d "$body" "$@"
      ;;
    *) echo "axapi: method must be get or post" >&2; exit 1 ;;
  esac
}

cmd_ingest() {
  [ -n "${1:-}" ] || { echo "usage: axapi ingest <url>" >&2; exit 1; }
  body="$(jq -nc --arg url "$1" '{url:$url}')"
  cmd_call comms post /ingest "$body"
}

cmd_feed() {
  days="${1:-7}"
  case "$days" in *[!0-9]*|'') echo "axapi: days must be a positive integer" >&2; exit 1 ;; esac
  cmd_call comms get "/feed?days=$days"
}

case "${1:-list}" in
  list|-l|--list) cmd_list ;;
  url) [ -n "${2:-}" ] || { echo "usage: axapi url <capability>" >&2; exit 1; }; cmd_url "$2" ;;
  health|status) cmd_health ;;
  call) [ "$#" -ge 4 ] || { echo "usage: axapi call <capability> <get|post> <path> [body] [curl-args...]" >&2; exit 1; }; shift; cmd_call "$@" ;;
  ingest) cmd_ingest "${2:-}" ;;
  feed) cmd_feed "${2:-7}" ;;
  *) echo "usage: axapi [list|url|health|call|ingest|feed]" >&2; exit 1 ;;
esac
