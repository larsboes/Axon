# Dependencies — installed in place, never committed.
node_modules/

# accordion.js is generated and NOT committed, matching upstream, which builds it at
# prepack for the npm tarball only. Nothing here needs it: the wrapper package.json
# beside the vendored trees points pi at extension/accordion.ts directly.
extension/accordion.js
*.tsbuildinfo

# extension/dist/client IS committed, deliberately. It is the SvelteKit browser build
# behind the Map. Upstream ships exactly this directory in its npm package (`files`)
# while never committing it to git; it is committed here because the client cannot be
# rebuilt from this tree — the build needs app/, which is not vendored. Rebuild
# instructions are in Packs/harness/README.md.
