# Copy into the owning overlay under capabilities/home-assistant/components.toml.
# The actual set is private because it describes one installation.

[example_component]
repo       = "owner/repository"
ref        = "v1.2.3"
kind       = "component"
provenance = "clean"

[example_package]
repo       = "owner/repository"
ref        = "0123456789ab"
kind       = "package"
file       = "path/to/package.yaml"
provenance = "clean"
