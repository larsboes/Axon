# Copy to machine.toml (gitignored — every machine sets its own) and fill in.
# tools/install.sh writes this file for you during setup; this .example only
# matters if you're hand-editing a machine.toml later (new container runtime,
# recovered machine, etc). This is the minimal shape — the full schema
# (capabilities array, [capability.<name>] port/backup overrides, [[state_mount]]
# registry) is documented in Axon's schemas/machine.toml.example; keep the two
# in sync from that side, not this stub.
os = "macos"                       # "macos" | "linux" | "windows"
container_runtime = "apple-container"  # "apple-container" | "docker" | "podman"

# Managed by tools/capability.sh enable/disable; empty is a valid machine.
capabilities = []
