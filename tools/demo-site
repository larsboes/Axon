#!/usr/bin/env bash
# tools/demo-site — assemble everything that gets published (#168).
#
#   site/
#     index.html      tools/generate-site   — the self-model, and the three ways in
#     docs/           tools/generate-docs   — one reference page per unit
#     demo/           the dashboard bundle, built with the fetch shim compiled in
#     demo/fixtures/  tools/demo-record     — what the seeded capabilities answered
#
# Every step is a tool that also runs on its own; this is the order they go in and the one
# place the base path is decided. It does NOT start capabilities or seed them — tools/demo-up
# does that, because a build step that quietly writes to a database is a build step nobody can
# read. Run demo-up first, or point AXON_DEMO_FIXTURES at a recording you already have.
#
# The gate at the end is not optional and not a warning. Nothing here uploads, so the last
# thing this script can do for a mistake is refuse to leave the bytes behind.
#
#   tools/demo-site                       build into site/, base path /
#   tools/demo-site --base /Axon          build for a GitHub Pages project site
#   tools/demo-site --out <dir>
set -euo pipefail

_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AXON_ROOT="$(cd "$_here/.." && pwd)"

OUT="$AXON_ROOT/site"
# Empty means the site is served from a domain root. A GitHub Pages PROJECT site is served
# from /<repo>, and a static SPA has to be told: its asset URLs and router links are baked in.
BASE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --out)  OUT="$2"; shift 2 ;;
    --base) BASE="${2%/}"; shift 2 ;;
    -h|--help) echo "usage: demo-site [--out <dir>] [--base /prefix]"; exit 0 ;;
    *) echo "demo-site: unknown argument '$1'" >&2; exit 1 ;;
  esac
done

FIXTURES="${AXON_DEMO_FIXTURES:-$AXON_ROOT/demo/fixtures}"
if [ ! -f "$FIXTURES/index.json" ]; then
  echo "demo-site: no recording at $FIXTURES/index.json — run tools/demo-up first." >&2
  exit 1
fi

rm -rf "$OUT"
mkdir -p "$OUT"

echo "demo-site: landing page"
"$_here/generate-site" --out "$OUT"

echo "demo-site: reference pages"
"$_here/generate-docs" --out "$OUT/docs" --fixtures "$FIXTURES"

echo "demo-site: dashboard bundle (base $BASE/demo)"
(
  cd "$AXON_ROOT/dashboard"
  # AXON_DEMO compiles the fetch shim in (vite.config.ts turns it into a literal, so a normal
  # build drops it); AXON_DEMO_BASE is what svelte.config.js bakes into every URL.
  AXON_DEMO=1 AXON_DEMO_BASE="$BASE/demo" bun run build >/dev/null
)
cp -R "$AXON_ROOT/dashboard/dist" "$OUT/demo"
cp -R "$FIXTURES" "$OUT/demo/fixtures"

# GitHub Pages serves this tree through Jekyll unless told not to, and Jekyll drops every
# directory beginning with an underscore — which is where SvelteKit puts the entire bundle.
# Without this the demo is a blank page whose console reports a 404 for _app.
touch "$OUT/.nojekyll"

echo "demo-site: hygiene gate"
"$_here/check-site-payload.sh" "$OUT"

echo "demo-site: $(du -sh "$OUT" | cut -f1) in $OUT"
