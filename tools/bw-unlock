#!/bin/bash
# bw-unlock — unlock the Bitwarden CLI without retyping the master password.
#
# Two separate costs make `bw unlock` annoying, and this addresses both:
#   what you type  -- where an OS secret store exists, the master password lives there, so
#                     the prompt is the OS's own (Mac login password / keyring unlock)
#   how often      -- the session key is cached, so a new shell reuses the unlock rather
#                     than starting from locked (capabilities/shell/init.{zsh,bash} pick it up)
#
# The master password reaches bw over a pipe as --passwordfile /dev/stdin: never in argv
# (visible in `ps`), never in an environment variable, never in shell history, never on
# disk outside the secret store.
#
# Three secret-store backends, chosen once at startup by `store_backend`:
#   macos  -- the login keychain via security(1)
#   linux  -- the Secret Service (GNOME Keyring / KWallet) via secret-tool(1)
#   none   -- no store available (common on WSL): `bwu` prompts for the master password
#             each time it re-unlocks, but the session cache still spares every new shell.
# The session-key cache (SESSION_FILE) is plain and identical on every platform; only the
# master-password-at-rest half is backend-specific.
#
# WHY THE LOGIN KEYCHAIN AND NOT THE SECURE ENCLAVE (macOS). The modern data-protection
# keychain is the one that can demand Touch ID, and on macOS it requires a
# keychain-access-groups entitlement. A CLI binary cannot carry one: ad-hoc signing gets
# the process SIGKILLed, and so does a real Apple Development identity with a team-prefixed
# group, because the entitlement wants a provisioning profile that only an app bundle can
# embed. Measured 2026-07-28, not assumed. The tempting fallback -- same biometry ACL
# against the legacy keychain -- is worse than useless: it ACCEPTS the access control and
# does not enforce it, handing the bytes over with no authentication at all. Verified too.
# So the gate here is the login keychain's own ACL, which is real: an item stored with
# `-T ''` trusts no application, and every read blocks on macOS's authorization prompt.
#
# ON LINUX the equivalent gate is the Secret Service collection's own lock: secret-tool
# reads block until the keyring is unlocked (typically once per login session). That is a
# real gate where a keyring daemon runs; where none does (a bare WSL shell), there is no
# store to enrol into and the backend is "none".
#
# THE TRADE, STATED PLAINLY. The cached session key is an unlocked vault for anything
# running as you. It is machine-local and one `bw lock` revokes it. The master password
# is neither -- it is the vault's root and works from any device -- which is why that one
# sits behind the gate and the session does not.
set -euo pipefail

SERVICE="axon-bw-master"
SESSION_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/axon/bw-session"

die() { echo "bw-unlock: $*" >&2; exit 1; }

command -v bw >/dev/null 2>&1 || die "no bw on PATH."

# Which master-password store this machine has. Resolved once; every store_* helper
# branches on it. Deliberately not exported — it's an internal implementation detail.
store_backend() {
  if [ "$(uname -s)" = "Darwin" ]; then
    command -v security >/dev/null 2>&1 && { echo macos; return; }
  elif command -v secret-tool >/dev/null 2>&1; then
    echo linux; return
  fi
  echo none
}
BACKEND="$(store_backend)"

# --- secret-store backend helpers (account is the arg where relevant) ------------------
# store_get_pw: print the stored master password to stdout (spent immediately over a pipe).
store_get_pw() {
  case "$BACKEND" in
    macos) security find-generic-password -w -s "$SERVICE" -a "$1" 2>/dev/null ;;
    linux) secret-tool lookup service "$SERVICE" account "$1" 2>/dev/null ;;
    none)  return 1 ;;
  esac
}
# store_has: 0 if a master password is enrolled for this account, 1 otherwise.
store_has() {
  case "$BACKEND" in
    # -w omitted: reads attributes only, raises no authorization prompt.
    macos) security find-generic-password -s "$SERVICE" -a "$1" >/dev/null 2>&1 ;;
    # No attribute-only probe on the Secret Service; a lookup that returns a value is the
    # only signal. May prompt to unlock the keyring, which is the same gate a real read hits.
    linux) secret-tool lookup service "$SERVICE" account "$1" >/dev/null 2>&1 ;;
    none)  return 1 ;;
  esac
}
# store_put: interactively store the master password (the tool does the prompting).
store_put() {
  case "$BACKEND" in
    macos)
      # -T '' trusts no application, so every later read blocks on macOS's own
      # authorization prompt. -U updates in place when re-enrolling after a change.
      security add-generic-password \
        -a "$1" -s "$SERVICE" -T '' -U \
        -l "Axon — Bitwarden master password" -w ;;
    linux)
      secret-tool store --label="Axon — Bitwarden master password" \
        service "$SERVICE" account "$1" ;;
    none)  return 1 ;;
  esac
}
# store_clear: remove the stored master password.
store_clear() {
  case "$BACKEND" in
    macos) security delete-generic-password -s "$SERVICE" -a "$1" >/dev/null 2>&1 ;;
    linux) secret-tool clear service "$SERVICE" account "$1" >/dev/null 2>&1 ;;
    none)  return 1 ;;
  esac
}

# The store item is scoped to the bw account, so a second account (or the family vault on
# its own server) gets its own item instead of silently overwriting this one. Deliberately
# not jq: bw's status line is a flat object and Axon does not carry a JSON dependency for
# one field.
bw_account() {
  local status_json account
  status_json="$(bw status 2>/dev/null)" || die "could not run \`bw status\`."
  case "$status_json" in
    *'"status":"unauthenticated"'*)
      die "bw is not logged in. Run \`bw login\` first — this unlocks, it does not log in." ;;
  esac
  account="$(printf '%s' "$status_json" | sed -n 's/.*"userEmail":"\([^"]*\)".*/\1/p')"
  [ -n "$account" ] || die "\`bw status\` returned no userEmail."
  printf '%s' "$account"
}

bw_locked() {
  case "$(bw status 2>/dev/null)" in
    *'"status":"unlocked"'*) return 1 ;;
    *) return 0 ;;
  esac
}

store_session() {
  local session="$1"
  mkdir -p "$(dirname "$SESSION_FILE")"
  chmod 700 "$(dirname "$SESSION_FILE")"
  # Create empty with the right mode BEFORE writing, so the key is never briefly
  # world-readable between creation and chmod.
  : > "$SESSION_FILE"
  chmod 600 "$SESSION_FILE"
  printf '%s\n' "$session" > "$SESSION_FILE"
}

# Unlock and cache the session. With a store, read the master password from it and spend
# it on an unlock (the pipe is the whole point: the value exists only in flight between
# the two processes). Without a store, unlock interactively — still caches the session so
# new shells reuse it, only the master password isn't remembered.
do_unlock() {
  local account session rc
  account="$(bw_account)"

  if [ "$BACKEND" = none ]; then
    [ -t 0 ] || die "no OS secret store (macOS keychain / secret-tool) and no tty to prompt. Run \`bw unlock\` and export BW_SESSION yourself."
    session="$(bw unlock --raw)" || die "unlock failed."
    [ -n "$session" ] || die "unlock produced no session key."
    store_session "$session"
    printf '%s\n' "$session"
    return
  fi

  set +e
  session="$(store_get_pw "$account" | bw unlock --passwordfile /dev/stdin --raw 2>/dev/null)"
  rc=$?
  set -e
  if [ $rc -ne 0 ] || [ -z "$session" ]; then
    if ! store_has "$account"; then
      die "nothing enrolled for $account. Run \`tools/bw-unlock --enroll\` first."
    fi
    die "unlock failed — the authorization was denied, or the stored master password is stale (re-run --enroll after a password change)."
  fi
  store_session "$session"
  printf '%s\n' "$session"
}

cmd_enroll() {
  local account
  account="$(bw_account)"
  if [ "$BACKEND" = none ]; then
    die "no OS secret store here (macOS keychain / Linux secret-tool). Nothing to enrol into — just run \`bwu\`, which prompts for the master password and then caches the session for new shells. Install a Secret Service (e.g. gnome-keyring + libsecret's secret-tool) to store the password too."
  fi
  [ -t 0 ] || die "--enroll needs a terminal: the secret store reads the password from the tty."

  echo "Storing the Bitwarden master password for $account in the $BACKEND secret store." >&2
  echo "It never passes through this script." >&2
  store_put "$account" || die "the secret store refused to hold the item."

  # Verify by spending it. A wrong password stored here would look fine until the first
  # real unlock, and fail at a point that no longer names the cause.
  echo "Verifying against bw — authorize the store read if asked." >&2
  if ! do_unlock >/dev/null; then
    store_clear "$account" || true
    die "bw rejected that master password — nothing was kept."
  fi
  echo "enrolled. New shells pick the session up; \`bwu\` re-unlocks when it goes stale." >&2
}

cmd_status() {
  local account enrolled
  account="$(bw_account)"
  if [ "$BACKEND" = none ]; then
    enrolled="n/a (no secret store)"
  elif store_has "$account"; then
    enrolled="yes"
  else
    enrolled="no"
  fi
  echo "backend:  $BACKEND"
  echo "account:  $account"
  echo "enrolled: $enrolled"
  echo "vault:    $(bw_locked && echo locked || echo unlocked)"
  if [ -f "$SESSION_FILE" ]; then
    echo "session:  cached ($SESSION_FILE)"
  else
    echo "session:  none"
  fi
}

cmd_forget() {
  local account
  account="$(bw_account)"
  if [ "$BACKEND" = none ]; then
    echo "no secret store — nothing enrolled to remove." >&2
  elif store_clear "$account"; then
    echo "removed the stored master password." >&2
  else
    echo "nothing was enrolled." >&2
  fi
  rm -f "$SESSION_FILE"
  bw lock >/dev/null 2>&1 || true
  echo "session cache cleared and the vault locked." >&2
}

usage() {
  cat >&2 <<'EOF'
tools/bw-unlock — unlock the Bitwarden CLI without retyping the master password.

  tools/bw-unlock            unlock (the OS asks to authorize), print the session key
  tools/bw-unlock --enroll   store the master password in the OS secret store (asks once)
  tools/bw-unlock --status   backend, what is enrolled, is the vault locked, session cached?
  tools/bw-unlock --forget   remove the stored password, clear the cache, lock the vault

Secret store per OS: macOS login keychain, Linux Secret Service (secret-tool). Where none
exists (e.g. WSL) unlock still works — it prompts for the master password and caches the
session so new shells reuse it; only --enroll is unavailable.

In a shell:  export BW_SESSION="$(tools/bw-unlock)"   — or just `bwu`, from
capabilities/shell/init.{zsh,bash}, which also picks up a cached session in every new shell.
EOF
}

case "${1:-}" in
  "")          do_unlock ;;
  --enroll)    cmd_enroll ;;
  --status)    cmd_status ;;
  --forget)    cmd_forget ;;
  -h|--help)   usage ;;
  *)           echo "bw-unlock: unknown argument $1" >&2; usage; exit 1 ;;
esac
