#!/usr/bin/env bash
# Thin launcher: the logic lives in lifeos-sync.ts. Sourcing paths.sh here keeps
# `axon.toml`'s overlay field the ONE place the overlay location is declared
# (README.md#dynamic-paths-and-current-facts) — the TS core reads the resolved values off the environment instead
# of re-implementing the lookup.
set -eu
_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tools/lib/paths.sh
. "$_here/lib/paths.sh"   # exports AXON_ROOT, AXON_PERSONAL_ROOT
exec bun run "$_here/lifeos-sync.ts" "$@"
