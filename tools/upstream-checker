#!/bin/bash
# upstream-checker — the M2 gate for upstreams.toml.
#
# Enforces Axon's dependency doctrine (README.md#dependency-verdicts-and-provenance, upstreams.toml header):
# every entry is complete with a valid verdict, and everything consumed is pinned.
# Run it BEFORE adding or bumping any dependency, package, or MCP server.
#
# The cooldown is reported, not enforced. Being inside the window is `ok` here:
# the pin is correct, the hold is a recommendation, and adopting early is the
# operator's judgement to make. What earns a warning is the opposite state, a
# cooldown that has passed with the pin left behind. An earlier header claimed
# --strict failed on in-cooldown bumps; it never did after that inversion, and
# saying so was worse than saying nothing.
#
# Published GitHub Security Advisories ARE enforced, unlike the cooldown: a pin inside an
# advisory's affected range fails. OSV does not carry GHSA for every ecosystem, so
# osv-scanner cannot see them and this is the only gate that can (Axon#124).
#
#   tools/upstream-checker            # audit the manifest, human report
#   tools/upstream-checker --strict   # also fail on warnings (stale pins, unverified drift)
#   tools/upstream-checker --offline  # skip the GitHub release/cooldown/advisory checks
#   tools/upstream-checker --json     # machine-readable report (dashboard feed); exits 0
#
# Exit 0 = clean, 1 = violation(s), 2 = usage error. bash 3.2-safe.
# --json is the exception: the report IS the result, so a manifest fail is data in the
# payload (totals.fail), not a non-zero exit — the one caller is axon-status, which wants
# the feed regardless of verdict counts.

set -u

_here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=tools/lib/paths.sh
. "$_here/lib/paths.sh"   # exports AXON_ROOT (+ AXON_PERSONAL_ROOT) and sources toml.sh
# The tracked manifest, unless a test points at a planted one. Same escape hatch as
# check-bun-pin.sh's AXON_BUN_PIN_ROOT, and for the same reason: the real manifest can only
# ever demonstrate the states it happens to be in, so the red paths below need a fixture.
MANIFEST="${AXON_UPSTREAMS_MANIFEST:-$AXON_ROOT/upstreams.toml}"

STRICT=0; OFFLINE=0; JSON=0
for a in "$@"; do
  case "$a" in
    --strict)  STRICT=1 ;;
    --offline) OFFLINE=1 ;;
    --json)    JSON=1 ;;
    -h|--help) sed -n '2,22p' "$0"; exit 0 ;;
    *) echo "upstream-checker: unknown flag '$a'" >&2; exit 2 ;;
  esac
done

[ -f "$MANIFEST" ] || { echo "upstream-checker: no manifest at $MANIFEST" >&2; exit 2; }

# Verdict vocabulary is derived from the manifest's own header comment
# (`# verdict = "adopt" | "contribute" | ...`) — one source of truth, not a
# second copy the checker can drift from. Fail loud if it can't be read.
VALID_VERDICTS="$(grep -E '^#[[:space:]]*verdict[[:space:]]*=' "$MANIFEST" | head -1 | grep -oE '"[a-z]+"' | tr -d '"' | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
[ -n "$VALID_VERDICTS" ] || { echo "upstream-checker: could not derive verdict vocabulary from $MANIFEST header comment" >&2; exit 2; }
# Same derivation for the pin shapes a GitHub release cannot describe. Declaring one turns the
# drift check off for that entry, so the vocabulary is deliberately not open: a typo must fail
# rather than quietly become a new way to stop being checked.
VALID_PIN_KINDS="$(grep -E '^#[[:space:]]*pin_kind[[:space:]]*=' "$MANIFEST" | head -1 | grep -oE '"[a-z]+"' | tr -d '"' | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
[ -n "$VALID_PIN_KINDS" ] || { echo "upstream-checker: could not derive pin_kind vocabulary from $MANIFEST header comment" >&2; exit 2; }
# "consumed" = integrated into Axon, therefore must be pinned. This is policy,
# stated nowhere else as a list, so it lives here as the single definition.
CONSUMED_VERDICTS="adopt contribute overlay fork"
# Cooldown window is machine/policy config, not a magic number in the gate.
COOLDOWN_MIN="$(toml_get_in upstream cooldown_min_days "$AXON_ROOT/axon.toml")"
COOLDOWN_MAX="$(toml_get_in upstream cooldown_max_days "$AXON_ROOT/axon.toml")"
{ [ -n "$COOLDOWN_MIN" ] && [ -n "$COOLDOWN_MAX" ]; } || { echo "upstream-checker: cooldown window missing from axon.toml [upstream]" >&2; exit 2; }

in_list() { case " $2 " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
# shellcheck source=lib/version.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/lib/version.sh"
# shellcheck source=lib/advisories.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/lib/advisories.sh"

# epoch_of <ISO8601 e.g. 2026-07-09T22:00:00Z> — GNU date first, BSD/macOS fallback.
epoch_of() {
  if date --version >/dev/null 2>&1; then
    date -u -d "$1" +%s 2>/dev/null
  else
    date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$1" +%s 2>/dev/null
  fi
}

# gh_latest <owner/repo> — prints "tag<TAB>published_at"; non-zero if unavailable.
gh_latest() {
  local repo="$1" json
  if command -v gh >/dev/null 2>&1; then
    json="$(gh api "repos/$repo/releases/latest" 2>/dev/null)"
  else
    json="$(curl -fsS "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null)"
  fi
  [ -z "$json" ] && return 1
  local tag pub
  tag="$(printf '%s' "$json" | grep -E '"tag_name"'     | head -1 | sed -E 's/.*"tag_name":[[:space:]]*"([^"]*)".*/\1/')"
  pub="$(printf '%s' "$json" | grep -E '"published_at"' | head -1 | sed -E 's/.*"published_at":[[:space:]]*"([^"]*)".*/\1/')"
  [ -z "$tag" ] && return 1
  printf '%s\t%s\n' "$tag" "$pub"
}

# gh_advisories and advisory_scan now live in lib/advisories.sh, sourced above. They moved
# there when the agentbox self-update gate became a second consumer (Axon#126): it asks the
# same question at a different moment — seconds before a binary is placed on the machine,
# rather than while auditing the manifest.

fail=0; warn=0; na=0; ok=0; count=0

# --json accumulates the same per-entry notes the human report prints, so the two views
# never drift: every status line goes through emit(), which either prints it (human) or
# buffers it for the entry's JSON `notes` array. One code path, two renderings.
ENTRY_NOTES=(); JSON_ENTRIES=""
emit() {  # a per-entry status note
  if [ "$JSON" -eq 1 ]; then ENTRY_NOTES+=("$1"); else echo "    $1"; fi
}
json_escape() {  # minimal JSON string escaping; notes are single-line
  local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '%s' "$s"
}

if [ "$JSON" -eq 0 ]; then
  # Repo-relative, not absolute: this report gets pasted into public GitHub issues by
  # .github/workflows/upstream-watch.yml, and an absolute path there leaks the writer's
  # filesystem layout for no reader benefit. The --json payload keeps the full path; its
  # consumers are local (dashboard, axon-status) and some of them need to open the file.
  echo "upstream-checker · ${MANIFEST#"$AXON_ROOT"/}"
  [ "$OFFLINE" -eq 1 ] && echo "  (offline — skipping release/cooldown checks)"
  echo
fi

for name in $(toml_sections "$MANIFEST"); do
  count=$((count + 1))
  url="$(toml_get_in "$name" url "$MANIFEST")"
  verdict="$(toml_get_in "$name" verdict "$MANIFEST")"
  license="$(toml_get_in "$name" license "$MANIFEST")"
  why="$(toml_get_in "$name" why "$MANIFEST")"
  pin="$(toml_get_in "$name" pin "$MANIFEST")"
  pin_kind="$(toml_get_in "$name" pin_kind "$MANIFEST")"
  tracked_by="$(toml_get_in "$name" tracked_by "$MANIFEST")"
  installed_probe="$(toml_get_in "$name" installed_probe "$MANIFEST")"

  entry_fail=0; entry_warn=0; entry_na=0; ENTRY_NOTES=()
  [ "$JSON" -eq 0 ] && printf '▸ %-28s %-11s pin %s\n' "$name" "${verdict:-—}" "${pin:-—}"

  # 1. completeness
  missing=""
  [ -z "$url" ]     && missing="$missing url"
  [ -z "$verdict" ] && missing="$missing verdict"
  [ -z "$license" ] && missing="$missing license"
  [ -z "$why" ]     && missing="$missing why"
  if [ -n "$missing" ]; then
    emit "✗ missing required field(s):$missing"
    entry_fail=1
  fi

  # 2. verdict enum
  if [ -n "$verdict" ] && ! in_list "$verdict" "$VALID_VERDICTS"; then
    emit "✗ invalid verdict '$verdict' (allowed: $VALID_VERDICTS)"
    entry_fail=1
  fi

  # 3. consumed → must be pinned
  if in_list "$verdict" "$CONSUMED_VERDICTS" && [ -z "$pin" ]; then
    emit "⚠ '$verdict' verdict without pin — pin the exact ref before consuming"
    entry_warn=1
  fi

  # 4. release-drift declaration — a pin that releases/latest cannot describe
  #
  # Ten of this manifest's entries are pinned to a commit sha, an image tag, a hosted API
  # surface or a data path. Each is the correct pin for what is consumed; none of them is a
  # GitHub release, so the check below could never resolve and warned every week forever. #5
  # was right that an unresolvable check is not a passed check — but a gate that warns
  # permanently about entries where nothing is wrong is one people learn to skim.
  #
  # So the manifest gets to say the check does not apply, in the same shape as every other
  # verdict in it: a vocabulary term plus prose. Validated rather than trusted, and paired with
  # tracked_by so opting out of this check is not opting out of thinking about staleness. Runs
  # offline too — whether a pin is a release tag is a fact about the manifest, not the network.
  if [ -n "$pin_kind" ] || [ -n "$tracked_by" ]; then
    if [ -z "$pin_kind" ]; then
      emit "✗ tracked_by without pin_kind — name the shape ($VALID_PIN_KINDS) or drop the field"
      entry_fail=1
    elif ! in_list "$pin_kind" "$VALID_PIN_KINDS"; then
      emit "✗ invalid pin_kind '$pin_kind' (allowed: $VALID_PIN_KINDS)"
      entry_fail=1
    elif [ -z "$tracked_by" ]; then
      emit "✗ pin_kind '$pin_kind' without tracked_by — say what keeps this entry current instead"
      entry_fail=1
    else
      emit "○ release drift n/a ($pin_kind) — tracked by: $tracked_by"
      entry_na=1
    fi
  fi

  # 4b. pin vs INSTALLED — the direction the drift check structurally cannot see
  #
  # Check 5 below compares the pin against releases/latest. Both sides are remote, so a pin and
  # an install can disagree indefinitely while the entry reports `ok` — which is exactly what
  # happened when brew moved typst and bitwarden-cli past their pins (#54). An entry whose pin
  # means "what is installed here" declares how to ask the host, and gets asked.
  #
  # Runs offline on purpose: this is a local question, and a check that only ran with a network
  # would be skipped in precisely the CI and cron paths that most need it. Costs one exec.
  if [ -n "$installed_probe" ]; then
    if ! probe_argv_safe "$installed_probe"; then
      emit "✗ installed_probe is not a safe argv — letters, digits and - _ . / = : only, no shell metacharacters"
      entry_fail=1
    elif [ -z "$pin" ]; then
      emit "✗ installed_probe without pin — there is nothing to compare the host against"
      entry_fail=1
    else
      # Word-split into an argv array and exec directly. No eval, no sh -c, no backticks: a
      # manifest value must never reach a shell, and probe_argv_safe is the belt to this
      # brace. An array rather than `set --` so the script's own positional parameters stay
      # intact — this runs once per entry, and a loop that quietly rewrites "$@" is a trap
      # for whoever adds the next check.
      probe_argv=()
      # shellcheck disable=SC2086
      for _w in $installed_probe; do probe_argv+=("$_w"); done
      if ! command -v "${probe_argv[0]}" >/dev/null 2>&1; then
        # Absent is its own answer. Reporting it as agreement would be the failure this whole
        # check exists to prevent, one level up.
        emit "⚠ pin claims $pin but '${probe_argv[0]}' is not installed on this machine — absent, not agreeing"
        entry_warn=1
      else
        probe_out="$("${probe_argv[@]}" 2>&1)" || probe_out=""
        installed_ver="$(probe_extract_version "$probe_out")"
        if [ -z "$installed_ver" ]; then
          emit "⚠ '$installed_probe' returned no version-shaped output — unprobeable, so the pin is unverified"
          entry_warn=1
        elif probe_agrees "$name" "$pin" "$installed_ver"; then
          emit "✓ installed matches the pin ($installed_ver, via '$installed_probe')"
        else
          emit "✗ pin says $pin, machine has $installed_ver — the package manager moved this, not Axon"
          entry_fail=1
        fi
      fi
    fi
  fi

  # 5. drift / cooldown — only for pinned GitHub upstreams whose pin a release can describe
  if [ "$entry_na" -eq 0 ] && [ "$OFFLINE" -eq 0 ] && [ -n "$pin" ] && printf '%s' "$url" | grep -q 'github.com'; then
    repo="$(printf '%s' "$url" | sed -E 's#.*github.com/([^/]+/[^/]+).*#\1#; s#\.git$##')"
    latest_line="$(gh_latest "$repo")"
    if [ -z "$latest_line" ]; then
      emit "⚠ latest release not resolvable (no releases / rate-limited) — drift unverified; if this pin is not a release, declare pin_kind + tracked_by"
      # A drift check that could not run is not a drift check that passed. An undeclared entry
      # stays a warning on purpose: rate limiting and a transient API failure land here too, and
      # a deliberate opt-out has to look different from one of those rather than identical.
      entry_warn=1
    else
      latest_tag="${latest_line%%	*}"
      latest_pub="${latest_line#*	}"
      age_days="?"
      pub_epoch="$(epoch_of "$latest_pub")"
      if [ -n "$pub_epoch" ]; then
        now_epoch="$(date -u +%s)"
        age_days=$(( (now_epoch - pub_epoch) / 86400 ))
      fi
      # The classification itself lives in tools/lib/version.sh so it can be tested without a
      # network call; here it is only rendered and counted.
      if note="$(drift_note "$name" "$pin" "$latest_tag" "$age_days" "$COOLDOWN_MIN" "$COOLDOWN_MAX")"; then
        emit "$note"
      else
        emit "$note"
        entry_warn=1
      fi
    fi
  fi

  # 6. published GitHub Security Advisories against the pin
  #
  # Runs regardless of pin_kind: an image tag or a commit sha is not a release, but it is
  # still a version somebody is running, and the advisory question is about exposure rather
  # than about drift. Offline-skippable like check 5.
  #
  # CONSUMED verdicts only, and that restriction is load-bearing rather than tidy. esphome
  # is pinned at 2026.5.3 and carries a high-severity advisory covering it -- but its
  # verdict is `reject`: it was removed on 2026-07-26 and the pin exists precisely so a
  # rejected thing cannot drift back in unnoticed. Failing the gate over a vulnerability in
  # software Axon deliberately does not run would train the operator to override it, on the
  # run where the finding was real.
  #
  # An in-range hit on something consumed IS a failure, not a warning.
  # README.md#pins-and-cooldown's active-vulnerability carve-out already names this as the
  # one reason to bump inside the cooldown hold, so the gate has to be able to say it out
  # loud rather than leave it in a column of things merely worth a look.
  if [ "$OFFLINE" -eq 0 ] && [ -n "$pin" ] && in_list "$verdict" "$CONSUMED_VERDICTS" \
     && printf '%s' "$url" | grep -q 'github.com'; then
    # Established before spending an API call: a sha pin has real advisory exposure and
    # nothing here can map it to a version range, so asking would only produce a list of
    # comparisons that cannot be made. Reported as `○` rather than `⚠` on purpose — it
    # joins the release-drift n/a group instead of warning forever about a pin shape that
    # will never become comparable.
    adv_repo="$(printf '%s' "$url" | sed -E 's#.*github.com/([^/]+/[^/]+).*#\1#; s#\.git$##')"
    adv_out="$(advisory_scan "$adv_repo" "$pin")"
    adv_rc=$?
    case "$adv_rc" in
      # advisory_scan establishes this before spending an API call: a sha pin has real
      # advisory exposure and nothing here can map it to a version range, so asking would
      # only produce a list of comparisons that cannot be made. Reported as `○` rather than
      # `⚠` on purpose — it joins the release-drift n/a group instead of warning forever
      # about a pin shape that will never become comparable.
      3) emit "○ advisory match n/a — pin '$pin' is not a version an advisory range can be compared against" ;;
      2) emit "⚠ advisories unchecked — gh is not installed, and OSV does not carry GHSA for every ecosystem"
         entry_warn=1 ;;
      # Same principle as the drift check's unresolvable branch: a check that could not run
      # is not a check that passed.
      1) emit "⚠ advisories not resolvable (rate-limited or unavailable) — GHSA exposure unverified"
         entry_warn=1 ;;
      0)
        adv_hits=0; adv_undecided=0; adv_total=0; adv_undecided_ids=""
        # Heredoc rather than a pipe: `while read` on the right of a pipe runs in a subshell
        # under bash 3.2, and every counter incremented in here would be discarded at the
        # loop's end — silently reporting zero hits over a list that had some.
        while IFS="$(printf '\t')" read -r adv_status adv_id adv_sev adv_range; do
          case "$adv_status" in
            hit) emit "✗ $adv_id ($adv_sev) — pin $pin is inside the affected range '$adv_range'"
                 adv_hits=$((adv_hits + 1)) ;;
            # Collected rather than printed one per line. GitHub lets an advisory carry a
            # free-text vulnerable_version_range, and real ones behind this manifest include
            # '2025.02 to 2026.01', '≤ 2026.5.2', '8+' and a bare '1.35.4'. Refusing to order
            # those is correct — inventing a verdict is the failure lib/version.sh exists to
            # prevent — but five separate warnings per entry is how a gate becomes wallpaper.
            undecided) adv_undecided=$((adv_undecided + 1))
                 adv_undecided_ids="$adv_undecided_ids $adv_id" ;;
            total) adv_total="$adv_id" ;;
          esac
        done <<ADVISORIES
$adv_out
ADVISORIES
        if [ "$adv_undecided" -gt 0 ]; then
          emit "⚠ $adv_undecided advisory range(s) not comparable to pin $pin — exposure undecided:$adv_undecided_ids"
        fi
        if [ "$adv_hits" -gt 0 ]; then
          entry_fail=1
        elif [ "$adv_undecided" -gt 0 ]; then
          entry_warn=1
        elif [ "$adv_total" -gt 0 ]; then
          # Said out loud rather than left to silence: "this repo publishes advisories and
          # none of them reaches this pin" is a different fact from "nobody looked".
          emit "✓ $adv_total published advisory range(s), none affecting pin $pin"
        fi ;;
    esac
  fi

  # n/a sits between ok and warn: an entry can be declared and still owe something else (an
  # unpinned consumed verdict, a missing field), and that has to win over the declaration.
  if [ "$entry_fail" -eq 1 ]; then
    fail=$((fail + 1)); entry_status="fail"
  elif [ "$entry_warn" -eq 1 ]; then
    warn=$((warn + 1)); entry_status="warn"
  elif [ "$entry_na" -eq 1 ]; then
    # `na`, not `n/a`: the human report can afford the slash, the machine view cannot — this
    # value becomes a CSS class on the dashboard and a jq selector in upstream-watch.yml.
    na=$((na + 1)); entry_status="na"
  else
    ok=$((ok + 1)); entry_status="ok"
  fi

  if [ "$JSON" -eq 1 ]; then
    notes_json=""
    if [ ${#ENTRY_NOTES[@]} -gt 0 ]; then
      for _n in "${ENTRY_NOTES[@]}"; do notes_json="$notes_json,\"$(json_escape "$_n")\""; done
      notes_json="${notes_json#,}"
    fi
    JSON_ENTRIES="$JSON_ENTRIES,{\"name\":\"$(json_escape "$name")\",\"verdict\":\"$(json_escape "$verdict")\",\"pin\":\"$(json_escape "$pin")\",\"pin_kind\":\"$(json_escape "$pin_kind")\",\"url\":\"$(json_escape "$url")\",\"status\":\"$entry_status\",\"notes\":[$notes_json]}"
  fi
done

if [ "$JSON" -eq 1 ]; then
  offline_bool=false; [ "$OFFLINE" -eq 1 ] && offline_bool=true
  printf '{"manifest":"%s","offline":%s,"totals":{"count":%d,"ok":%d,"na":%d,"warn":%d,"fail":%d},"entries":[%s]}\n' \
    "$(json_escape "$MANIFEST")" "$offline_bool" "$count" "$ok" "$na" "$warn" "$fail" "${JSON_ENTRIES#,}"
  exit 0
fi

echo
# Say which question the totals answer. Offline runs never touch the drift block, so an offline
# "all ok" means the manifest is well-formed and nothing at all is known about staleness. That
# distinction was invisible, and tools/doctor spawns this with --offline — so its supply-chain
# line was reporting a format check under a supply-chain heading.
if [ "$OFFLINE" -eq 1 ]; then
  scope="manifest format only — drift and cooldown NOT checked (run without --offline)"
else
  scope="manifest format + upstream drift"
fi
echo "── $count entries · $ok ok · $na n/a · $warn warn · $fail fail ── $scope"
# Its own group, not a silent fold into ok: an entry nobody checks should stay visible as one.
[ "$na" -gt 0 ] && echo "   n/a = release drift declared inapplicable (pin_kind), tracked by the stated mechanism instead"

exit_code=0
[ "$fail" -gt 0 ] && exit_code=1
if [ "$STRICT" -eq 1 ] && [ "$warn" -gt 0 ]; then
  echo "(--strict: warnings promoted to failures)"
  exit_code=1
fi
exit "$exit_code"
