load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# README.md is otherwise private to this package -- exported so the root
# //:architecture_up_to_date_test can reference it across the package boundary.
# Visibility only, no effect on the Rust build. See root BUILD.bazel.
exports_files(["README.md", "Cargo.toml"])

# libs/inference -- a shared library, not a capability (no domain of its own,
# no upstream verdict, no CLI). See README.md#three-architectural-nouns.
rust_library(
    name = "inference",
    crate_name = "axon_inference",
    # Globbed rather than listed — see capabilities/scouting/BUILD.bazel (Axon#13). One
    # file today; the glob is what keeps the second one from needing an edit here.
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@crate_index//:reqwest",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
    ],
)

rust_test(
    name = "inference_test",
    crate = ":inference",
    size = "small",
)
