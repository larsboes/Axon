load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["README.md", "Cargo.toml"])

# libs/station-time -- a shared library, not a capability (no domain of its own,
# no upstream verdict, no CLI). See README.md#three-architectural-nouns.
rust_library(
    name = "station-time",
    crate_name = "station_time",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@crate_index//:chrono",
        "@crate_index//:chrono-tz",
    ],
)

rust_test(
    name = "station_time_test",
    crate = ":station-time",
    size = "small",
)
