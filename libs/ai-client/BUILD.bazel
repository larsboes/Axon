load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# README.md is otherwise private to this package -- exported so the root
# //:architecture_up_to_date_test can reference it across the package boundary.
# Visibility only, no effect on the Rust build. See root BUILD.bazel.
exports_files(["README.md"])

# libs/ai-client -- a shared library, not a capability (no domain of its own, no
# upstream verdict, no CLI). See README.md#three-architectural-nouns.
# No type-sharing with scouting/transit/axon-status, so it gets its own crate index
# (@crate_index in MODULE.bazel), per
# MODULE.bazel's crate_index block.
rust_library(
    name = "ai-client",
    # Globbed rather than listed — see capabilities/scouting/BUILD.bazel for why the
    # hand-maintained inventory was the drift risk (Axon#13). No exclusion: this lib owns
    # no binary, so every source under src/ belongs to this crate.
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@crate_index//:reqwest",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
        "@crate_index//:tokio",
    ],
)

rust_test(
    name = "ai_client_test",
    crate = ":ai-client",
    size = "small",
)
