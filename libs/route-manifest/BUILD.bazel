load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Exported for //:architecture_up_to_date_test and for the #[path] include
# consumers use instead of a cargo path dependency — see libs/axon-config/BUILD.bazel.
exports_files(["README.md", "Cargo.toml", "src/lib.rs"])

# libs/route-manifest -- a shared library, not a capability (no domain of its own,
# no upstream verdict, no CLI). See README.md#three-architectural-nouns.
rust_library(
    name = "route-manifest",
    crate_name = "route_manifest",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["standalone-tests"],
    edition = "2021",
    visibility = ["//visibility:public"],
    # Only this standalone target needs a registry; consumers resolve serde from
    # their own index because they compile src/lib.rs into their crate.
    deps = [
        "@crate_index//:serde",
        "@crate_index//:serde_json",
    ],
)

rust_test(
    name = "route_manifest_test",
    crate = ":route-manifest",
    size = "small",
)
