load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Exported for //:architecture_up_to_date_test.
exports_files(["README.md", "Cargo.toml"])

# libs/route-manifest -- a shared library, not a capability (no domain of its own,
# no upstream verdict, no CLI). See README.md#three-architectural-nouns.
rust_library(
    name = "route-manifest",
    crate_name = "route_manifest",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@crate_index//:schemars",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
    ],
)

rust_test(
    name = "route_manifest_test",
    crate = ":route-manifest",
    size = "small",
)
