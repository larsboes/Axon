load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# README.md is exported so the root //:architecture_up_to_date_test can reference
# it across the package boundary.
exports_files(["README.md", "Cargo.toml"])

# libs/axon-store -- a shared library, not a capability (no domain of its own, no
# upstream verdict, no CLI). See README.md#three-architectural-nouns.
#
# The cross-process gate is a Postgres advisory lock, so this crate owns the
# client and pool dependencies it needs to take that lock.
rust_library(
    name = "axon-store",
    crate_name = "axon_store",
    # Globbed rather than listed, matching //libs/axon-config: the point is that
    # the day this becomes two files is not a day anyone has to remember this
    # file exists.
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@crate_index//:postgres",
        "@crate_index//:r2d2",
        "@crate_index//:r2d2_postgres",
    ],
)

rust_test(
    name = "axon_store_test",
    crate = ":axon-store",
    size = "small",
)
