load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# README.md is otherwise private to this package -- exported so the root
# //:architecture_up_to_date_test can reference it across the package boundary.
# Visibility only, no effect on the Rust build.
exports_files(["README.md", "Cargo.toml"])

rust_library(
    name = "axon-server",
    crate_name = "axon_server",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/axon-config:axon-config",
        "@crate_index//:axum",
        "@crate_index//:serde_json",
        "@crate_index//:tokio",
    ],
)

rust_test(
    name = "axon_server_test",
    crate = ":axon-server",
    size = "small",
    # Cargo dev-dependencies: the gate is a middleware layer, so its tests drive
    # it over a real ephemeral loopback listener rather than calling a handler.
    deps = ["@crate_index//:reqwest"],
)
