load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

# README.md is otherwise private to this package -- exported so the root
# //:architecture_up_to_date_test can reference it across the package boundary.
exports_files(["README.md", "service.toml"])

rust_binary(
    name = "axon-status",
    crate_root = "src/main.rs",
    srcs = ["src/main.rs", "//libs/axon-server:src/lib.rs",
        "//libs/route-manifest:src/lib.rs", "//libs/axon-config:src/lib.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@crate_index_axon_status//:axum",
        "@crate_index_axon_status//:reqwest",
        "@crate_index_axon_status//:serde",
        "@crate_index_axon_status//:serde_json",
        "@crate_index_axon_status//:tokio",
    ],
)

# This package has carried a #[cfg(test)] module since the backup surface was built and had no
# way to run it: every sibling declares a rust_test, this one did not, so `bazel test //...`
# was green over tests that were never compiled. Same class as the targets fixed in 7931ded,
# found while adding the external-reference cases and swept for across every Rust package (it
# was the only one left). `crate = ":axon-status"` rather than a library target, because this
# capability is a single binary crate and splitting it to gain a test target would be moving
# code to satisfy a build file.
rust_test(
    name = "axon_status_test",
    size = "small",
    crate = ":axon-status",
)
