#!/bin/bash
# capabilities/host-net/host-net — what this host exposes to the network, read without sudo.
# Named after its capability, which is what puts this directory on PATH
# (capabilities/shell/init.zsh).
# Portable shell only (README.md#portable-shell) — no bash-4-only syntax.
set -euo pipefail

_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../../tools/lib/paths.sh
source "$_dir/../../tools/lib/paths.sh"

# The shared workspace target/ at the repo root, which is where cargo puts every member's
# binaries. Same path shape capabilities/punctuality/punctuality uses.
BIN="$AXON_ROOT/target/release/host-net-cli"

# Build on first use rather than making a clone's first run a confusing "not found".
# Build output goes to stderr so `host-net check --json | jq` still works.
#
# tools/host-watch calls the BINARY directly and never this script, so an hourly job can
# never trigger a cargo build. That is a decision, not an accident: see
# capabilities/host-net/README.md.
if [ ! -x "$BIN" ]; then
  echo "host-net: building (first run)…" >&2
  (cd "$AXON_ROOT" && cargo build --locked --release --bin host-net-cli) >&2
fi

exec "$BIN" "$@"
