load("//tools/bazel/bun:build.bzl", "bun_vite_build")

# The manifest and its lockfile are also read by //tools/bazel/bun:deps.bzl at
# fetch time, which needs them visible as plain source files.
exports_files([
    "package.json",
    "bun.lock",
])

# The capability's own surface, per README.md#three-architectural-nouns: served over the
# capability's HTTP surface rather than by the spine shell. That makes the built
# bundle a real build output with a named consumer, which is what reopened the
# frontend-in-Bazel question (see MODULE.bazel's bun block).
bun_vite_build(
    name = "bundle",
    srcs = glob(
        [
            "src/**",
            "static/**",
        ],
        allow_empty = True,
    ) + [
        "package.json",
        "svelte.config.js",
        "tsconfig.json",
        "vite.config.ts",
    ],
    node_modules = "@soundscape_ui_deps//:node_modules",
    visibility = ["//visibility:public"],
)
