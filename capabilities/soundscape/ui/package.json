  },
  "dependencies": {
    "@sveltejs/kit": "^2.70.3",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^26.4.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  }
