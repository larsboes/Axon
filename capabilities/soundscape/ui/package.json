{
  "name": "@axon/soundscape-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The soundscape capability's own surface — the browser half, where Web Audio has to run.",
  "overrides": {
    "cookie": "0.7.2",
    "nanoid": "3.3.18"
