load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["README.md", "service.toml"])

rust_library(
    name = "tasks_lib",
    crate_name = "tasks",
    crate_root = "src/lib.rs",
    # Globbed rather than listed — see capabilities/scouting/BUILD.bazel for why the
    # hand-maintained inventory was the drift risk (Axon#13). src/server.rs is excluded
    # because it is the server binary's own crate root; the //libs sources stay explicit
    # because a glob cannot cross a package boundary.
    srcs = glob(["src/**/*.rs"], exclude = ["src/server.rs"]) + [
        "//libs/axon-config:src/lib.rs",
        # When the schema migration runs — shared by all seven schema-owning capabilities.
        "//libs/axon-store:src/lib.rs",
        "//libs/content-item:src/lib.rs",
    ],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@crate_index//:postgres",
        "@crate_index//:r2d2",
        "@crate_index//:r2d2_postgres",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
    ],
)

# The server owns Tasks' hermetic route-contract tests. The library's current
# test module is entirely Postgres-backed and belongs to the explicit target
# below instead of making the default suite depend on a service.
rust_test(
    name = "tasks_test",
    crate = ":tasks-server",
    size = "small",
)

rust_test(
    name = "tasks_postgres_test",
    args = ["store::tests::"],
    crate = ":tasks_lib",
    size = "small",
    tags = [
        "manual",
        "postgres-integration",
    ],
)

rust_binary(
    name = "tasks-server",
    crate_root = "src/server.rs",
    srcs = [
        "src/server.rs",
        "//libs/axon-server:src/lib.rs",
        "//libs/route-manifest:src/lib.rs",
        "//libs/axon-config:src/lib.rs",
    ],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":tasks_lib",
        "@crate_index//:axum",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
        "@crate_index//:tokio",
        "@crate_index//:tower-http",
    ],
)
