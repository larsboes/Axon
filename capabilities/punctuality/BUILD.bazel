load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# README.md is otherwise private to this package -- exported so the root
# //:architecture_up_to_date_test can reference it across the package boundary.
exports_files(["README.md", "Cargo.toml", "service.toml"])

rust_library(
    name = "punctuality_lib",
    crate_name = "punctuality",
    crate_root = "src/lib.rs",
    # Globbed rather than listed — see capabilities/scouting/BUILD.bazel for why the
    # hand-maintained inventory was the drift risk (Axon#13). Binary roots excluded because
    # they are their own crates. The remaining source include belongs to Axon#111.
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs", "src/server.rs"]) + [
        # When the schema migration runs — shared by all seven schema-owning capabilities.
        "//libs/axon-store:src/lib.rs",
    ],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/axon-config:axon-config",
        "@crate_index//:arrow",
        "@crate_index//:parquet",
        "@crate_index//:postgres",
        "@crate_index//:r2d2",
        "@crate_index//:r2d2_postgres",
        "@crate_index//:reqwest",
        "@crate_index//:serde",
        "@crate_index//:thiserror",
    ],
)

# The same #[cfg(test)] modules `cargo test` runs: histogram arithmetic, the local-clock
# derivation, release-name parsing, DSN redaction, EVA normalization. All pure -- nothing
# here needs Postgres or the network, which is what keeps it runnable in Bazel's sandbox
# (unlike scouting/transit/comms, whose store tests need the live database).
rust_test(
    name = "punctuality_test",
    crate = ":punctuality_lib",
    size = "small",
)

# punctuality-cli, not punctuality: capabilities/punctuality/punctuality is the shell
# entry point on PATH, and a target with that name would collide with the file inside
# this package. Same reason capabilities/comms names its binary comms-cli.
rust_binary(
    name = "punctuality-cli",
    srcs = ["src/main.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":punctuality_lib",
        "@crate_index//:reqwest",
    ],
)

# punctuality-server: the contract capabilities/transit reads this through (README.md#schemas-and-dependency-direction --
# a capability depends on another's HTTP surface, never its code). Async only here; the
# library and CLI stay sync, same split transit makes.
rust_binary(
    name = "punctuality-server",
    crate_root = "src/server.rs",
    srcs = ["src/server.rs", "//libs/axon-server:src/lib.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":punctuality_lib",
        "//libs/axon-config:axon-config",
        "//libs/route-manifest:route-manifest",
        "@crate_index//:axum",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
        "@crate_index//:tokio",
        "@crate_index//:tower-http",
    ],
)
