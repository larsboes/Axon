#!/bin/bash
# capabilities/host-audit/host-audit — inventory the host's installed packages, diff that
# against Axon's declared base (toolchain.toml, via tools/toolchain-check), record a snapshot
# in the overlay, and CVE-scan the installed set with trivy. The "watch what I'm using" tool.
#
# Distinct from tools/audit: that gate scans Axon's OWN repo + overlay; this scans the whole
# machine's package surface. Portable shell only (README.md#portable-shell) — no bash-4-only syntax.
#
#   host-audit inventory [--json]    # what's installed, grouped base (in toolchain.toml) vs extra
#   host-audit snapshot              # write inventory --json to the overlay + update latest.json
#   host-audit diff [--since <file>] # current vs latest snapshot (default): added/removed/changed
#   host-audit scan [--sarif <dir>]  # CVE scan of installed OS packages via trivy
#   host-audit -h                    # this help
#
# Branches on which package manager is PRESENT (apt/dpkg, brew), not on OS — robust to
# linuxbrew and to either platform. bash 3.2-safe.
set -euo pipefail

_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../../tools/lib/paths.sh
source "$_dir/../../tools/lib/paths.sh"   # AXON_ROOT, AXON_PERSONAL_ROOT

DATA_DIR="$AXON_PERSONAL_ROOT/data/host-audit"
TOOLCHAIN_CHECK="$AXON_ROOT/tools/toolchain-check"

usage() { sed -n '2,20p' "$0"; }

require_jq() {
  command -v jq >/dev/null 2>&1 && return 0
  case "$(uname -s)" in
    Darwin) echo "host-audit: 'jq' not found — brew install jq" >&2 ;;
    *)      echo "host-audit: 'jq' not found — apt-get install -y jq" >&2 ;;
  esac
  exit 1
}

# ---- discovery: emit `name<TAB>version<TAB>manager<TAB>origin`, one package per line -------

discover_apt() {
  # apt-mark showmanual is the MANUALLY-installed set — the "what I chose" signal, not the full
  # dependency closure. One dpkg-query for all installed versions, filtered to the manual set by
  # awk (a per-package dpkg-query call would fork hundreds of times).
  local tmp
  tmp="$(mktemp)"
  apt-mark showmanual 2>/dev/null > "$tmp" || true
  if [ -s "$tmp" ]; then
    dpkg-query -W -f='${Package}\t${Version}\n' 2>/dev/null \
      | awk -F'\t' 'NR==FNR{keep[$1]=1;next} ($1 in keep){print $1"\t"$2"\tapt\tmanual"}' "$tmp" - \
      || true
  fi
  rm -f "$tmp"
}

discover_brew() {
  # brew leaves --installed-on-request = formulae the user explicitly asked for (not pulled in
  # as dependencies). `brew list --versions` prints "name ver [older-vers...]"; take the first.
  local tmp
  tmp="$(mktemp)"
  brew leaves --installed-on-request 2>/dev/null > "$tmp" || true
  if [ -s "$tmp" ]; then
    brew list --versions 2>/dev/null \
      | awk 'NR==FNR{keep[$1]=1;next} ($1 in keep){print $1"\t"$2"\tbrew\tleaf"}' "$tmp" - \
      || true
  fi
  rm -f "$tmp"
  brew list --cask --versions 2>/dev/null | awk 'NF{print $1"\t"$2"\tcask\tcask"}' || true
}

discover() {
  command -v dpkg-query >/dev/null 2>&1 && discover_apt
  command -v brew       >/dev/null 2>&1 && discover_brew
  true
}

# ---- inventory JSON: the one source both the human report and snapshots render from ---------

build_inventory_json() {
  require_jq
  local os base mgrs
  os="$(uname -s | tr 'A-Z' 'a-z')"
  # Base = every tool id AND bin toolchain.toml declares — the set to flag as "Axon's base".
  base="$("$TOOLCHAIN_CHECK" --json 2>/dev/null | jq -c '[.entries[]|.tool,.bin]|unique' 2>/dev/null || echo '[]')"
  mgrs=""
  command -v dpkg-query >/dev/null 2>&1 && mgrs="${mgrs}apt,"
  command -v brew       >/dev/null 2>&1 && mgrs="${mgrs}brew,"
  discover | jq -R -s --argjson base "$base" --arg os "$os" --arg mgrs "${mgrs%,}" '
    (split("\n") | map(select(length > 0)) | map(split("\t"))
      | map(. as $p | { name:$p[0], version:$p[1], manager:$p[2], origin:$p[3],
                        base: (($base | index($p[0])) != null) })) as $pkgs
    | { os:$os,
        managers: ($mgrs | split(",") | map(select(length > 0))),
        packages: $pkgs,
        totals: { count: ($pkgs|length),
                  base:  ([$pkgs[]|select(.base)]|length),
                  extra: ([$pkgs[]|select(.base|not)]|length) } }'
}

cmd_inventory() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1
  local inv
  inv="$(build_inventory_json)"
  if [ "$json" -eq 1 ]; then printf '%s\n' "$inv"; return; fi
  printf '%s\n' "$inv" | jq -r '
    "host-audit · inventory",
    "  os=\(.os)  managers=\(.managers|join(",")//"none")  \(.totals.count) packages · \(.totals.base) base · \(.totals.extra) extra",
    "",
    "Base (declared in toolchain.toml):",
    (.packages | map(select(.base)) | sort_by(.name)[] | "  ✓ \(.name) \(.version) [\(.manager)]"),
    "",
    "Extra (this machine'"'"'s own surface):",
    (.packages | map(select(.base|not)) | sort_by(.name)[] | "  · \(.name) \(.version) [\(.manager)]")
  '
}

cmd_snapshot() {
  require_jq
  mkdir -p "$DATA_DIR"
  local ts f
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  f="$DATA_DIR/inventory-$ts.json"
  build_inventory_json > "$f"
  cp "$f" "$DATA_DIR/latest.json"
  echo "host-audit: wrote $f"
  echo "host-audit: updated $DATA_DIR/latest.json"
  echo "host-audit: snapshots live in the overlay (machine-specific, backed up with it — README.md#one-manifest-per-concern and README.md#state-mounts-record-reality)"
}

cmd_diff() {
  require_jq
  local since="$DATA_DIR/latest.json"
  if [ "${1:-}" = "--since" ]; then since="${2:-}"; shift 2 || true; fi
  if [ ! -f "$since" ]; then
    echo "host-audit: no snapshot at $since — run: host-audit snapshot" >&2
    exit 1
  fi
  local cur
  cur="$(build_inventory_json)"
  jq -n --slurpfile old "$since" --argjson new "$cur" '
    ($old[0].packages | map({key:.name, value:.version}) | from_entries) as $o |
    ($new.packages     | map({key:.name, value:.version}) | from_entries) as $n |
    { added:   [ $n|keys[]|select($o[.]==null)                     | {name:., version:$n[.]} ],
      removed: [ $o|keys[]|select($n[.]==null)                     | {name:., version:$o[.]} ],
      changed: [ $n|keys[]|select($o[.]!=null and $o[.]!=$n[.])    | {name:., from:$o[.], to:$n[.]} ] }
  ' | jq -r --arg since "$since" '
    "host-audit · diff vs \($since)",
    "  + added \(.added|length) · - removed \(.removed|length) · ~ changed \(.changed|length)",
    "",
    (.added[]   | "  + \(.name) \(.version)"),
    (.removed[] | "  - \(.name) \(.version)"),
    (.changed[] | "  ~ \(.name) \(.from) → \(.to)")
  '
}

cmd_scan() {
  local sarif_dir=""
  if [ "${1:-}" = "--sarif" ]; then sarif_dir="${2:-}"; shift 2 || true; fi
  if ! command -v trivy >/dev/null 2>&1; then
    echo "host-audit: trivy not installed — the CVE scan needs it." >&2
    if command -v jq >/dev/null 2>&1; then
      local hint
      hint="$("$TOOLCHAIN_CHECK" --json 2>/dev/null | jq -r '.entries[]|select(.tool=="trivy")|.install' 2>/dev/null || true)"
      [ -n "$hint" ] && echo "  install: $hint" >&2
    fi
    exit 1
  fi
  [ -n "$sarif_dir" ] && mkdir -p "$sarif_dir"
  local rc=0
  case "$(uname -s)" in
    Linux)
      echo "host-audit · trivy rootfs — installed OS packages, CRITICAL/HIGH"
      trivy rootfs --scanners vuln --pkg-types os --severity CRITICAL,HIGH --exit-code 1 / || rc=$?
      if [ -n "$sarif_dir" ]; then
        trivy rootfs --scanners vuln --pkg-types os --severity CRITICAL,HIGH \
          --format sarif --output "$sarif_dir/host-audit-rootfs.sarif" / >/dev/null 2>&1 || true
      fi
      ;;
    Darwin)
      # trivy has no Homebrew analyzer, so brew CVE cross-ref is a real gap — said out loud, not
      # silently skipped (README.md#documentation-stays-owned-and-current). inventory/diff still work; the Linux OS-package path doesn't
      # apply. Candidate to close it: query OSV by formula (not built yet).
      echo "host-audit: on macOS, trivy has no Homebrew analyzer — brew CVE cross-ref is a KNOWN GAP." >&2
      echo "  inventory/diff work fully; OS-package CVE scanning is the Linux (trivy rootfs) path." >&2
      echo "  Candidate to close the gap: OSV query by formula (not yet built)." >&2
      rc=2
      ;;
    *) echo "host-audit: unsupported OS for scan ($(uname -s))" >&2; rc=2 ;;
  esac
  [ -n "$sarif_dir" ] && [ "$rc" -ne 2 ] && echo "host-audit: SARIF written under $sarif_dir"
  return "$rc"
}

case "${1:-}" in
  inventory) shift; cmd_inventory "$@" ;;
  snapshot)  shift; cmd_snapshot "$@" ;;
  diff)      shift; cmd_diff "$@" ;;
  scan)      shift; cmd_scan "$@" ;;
  -h|--help) usage ;;
  *)         usage; exit 1 ;;
esac
