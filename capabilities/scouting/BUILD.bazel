load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# README.md is otherwise private to this package -- exported so the root
# //:architecture_up_to_date_test can reference it across the package boundary.
# Visibility only, no effect on the Rust build. See root BUILD.bazel.
exports_files(["README.md", "service.toml"])

# Library target is named "scouting" (not "scouting_lib") so its default
# crate_name matches what main.rs already imports (`use scouting::...`) --
# same name Cargo.toml's [lib] section uses. Keep the two in lockstep.
rust_library(
    name = "scouting",
    crate_root = "src/lib.rs",
    # Globbed, not listed: Cargo discovers src/ on its own, so a hand-maintained Bazel list
    # is a second inventory that only drifts in one direction. It went stale here once
    # already (an E0583 cascade, 2026-07-17) and comms hand-added two more files in 2026-07,
    # so the class was alive rather than historical (Axon#13). glob() has no hermeticity
    # cost: it is evaluated at load time against the package's own files and its result is
    # tracked, so a new source triggers re-analysis the same way an edited one does.
    #
    # The binary roots are excluded for the reason Cargo excludes them: src/main.rs and
    # src/server.rs are their own crates, listed by the rust_binary targets below. Leaving
    # them in would declare inputs this crate never compiles and rebuild the library
    # whenever a binary changed.
    #
    # Runtime-heavy shared sources remain explicit until Axon#111.
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs", "src/server.rs"]) + [
        # When the schema migration runs — shared by all seven schema-owning capabilities.
        "//libs/axon-store:src/lib.rs",
        "//libs/inference:src/lib.rs",
    ],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        # One-directional: scouting depends on transit, never the reverse
        # (see Cargo.toml's comment on the same dependency).
        "//capabilities/transit:transit_lib",
        "//libs/axon-config:axon-config",
        "//libs/markdown-root:markdown-root",
        "@crate_index//:postgres",
        "@crate_index//:r2d2",
        "@crate_index//:r2d2_postgres",
        "@crate_index//:reqwest",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
        "@crate_index//:thiserror",
    ],
)

# Runs the hermetic #[cfg(test)] modules. The Postgres-backed store module is
# selected by scouting_postgres_test below.
rust_test(
    name = "scouting_test",
    args = [
        "--skip",
        "store::tests::",
    ],
    crate = ":scouting",
    size = "small",
)

rust_test(
    name = "scouting_postgres_test",
    args = ["store::tests::"],
    crate = ":scouting",
    size = "small",
    tags = [
        "manual",
        "postgres-integration",
    ],
)

# The seam the unit tests cannot reach: a declared source entry becoming an
# adapter, its glob becoming files, and those files becoming scored
# opportunities against a real directory tree (retired-tracker#22). A separate
# target rather than a `crate` test because it links the library from outside,
# the way a caller does.
#
# Hermetic: the suite points AXON_PERSONAL_ROOT at an empty temp dir so no
# `embedding` role resolves and the scorer hashes instead of reaching a model
# server. Every fixture is written and removed by the test.
rust_test(
    name = "scouting_integration_test",
    srcs = ["tests/integration.rs"],
    size = "small",
    deps = [
        ":scouting",
        "@crate_index//:serde_json",
    ],
)

rust_binary(
    name = "scout",
    srcs = ["src/main.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":scouting",
        # main.rs calls transit::config::Config::load() / transit::store::TransitStore
        # directly (not just through :scouting) -- Bazel needs it declared here too.
        "//capabilities/transit:transit_lib",
        "@crate_index//:serde_json",
    ],
)

# scout-server: scouting's own HTTP API (axum). See
# dashboard/README.md — reopens the
# prior no-server call now that dashboard is a named consumer.
rust_binary(
    name = "scout-server",
    crate_root = "src/server.rs",
    srcs = ["src/server.rs", "//libs/axon-server:src/lib.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":scouting",
        "//capabilities/transit:transit_lib",
        "//libs/axon-config:axon-config",
        "//libs/route-manifest:route-manifest",
        "@crate_index//:axum",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
        "@crate_index//:tokio",
        "@crate_index//:tower-http",
    ],
)

# The two binary crates carry their own #[cfg(test)] modules, and until these
# targets existed `cargo test` ran them while bazel did not — the Axon#30
# false-green shape, one layer over. `scout`'s tests pin adapter-name
# resolution (an unknown name must build nothing rather than quietly running
# EuroHackathons); `scout-server`'s pin the route manifest against the router's
# own source.
rust_test(
    name = "scout_test",
    crate = ":scout",
    size = "small",
)

rust_test(
    name = "scout_server_test",
    crate = ":scout-server",
    size = "small",
)
