load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# README.md is otherwise private to this package -- exported so the root
# //:architecture_up_to_date_test can reference it across the package boundary.
# Visibility only, no effect on the Rust build. See root BUILD.bazel.
exports_files(["README.md", "service.toml"])

# Library target is named "scouting" (not "scouting_lib") so its default
# crate_name matches what main.rs already imports (`use scouting::...`) --
# same name Cargo.toml's [lib] section uses. Keep the two in lockstep.
rust_library(
    name = "scouting",
    crate_root = "src/lib.rs",
    # Globbed, not listed: Cargo discovers src/ on its own, so a hand-maintained Bazel list
    # is a second inventory that only drifts in one direction. It went stale here once
    # already (an E0583 cascade, 2026-07-17) and comms hand-added two more files in 2026-07,
    # so the class was alive rather than historical (Axon#13). glob() has no hermeticity
    # cost: it is evaluated at load time against the package's own files and its result is
    # tracked, so a new source triggers re-analysis the same way an edited one does.
    #
    # The binary roots are excluded for the reason Cargo excludes them: src/main.rs and
    # src/server.rs are their own crates, listed by the rust_binary targets below. Leaving
    # them in would declare inputs this crate never compiles and rebuild the library
    # whenever a binary changed.
    #
    # The //libs sources stay explicit: they belong to other Bazel packages, which a
    # glob cannot reach by design.
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs", "src/server.rs"]) + [
        "//libs/axon-config:src/lib.rs",
        "//libs/inference:src/lib.rs",
        "//libs/markdown-root:src/lib.rs",
    ],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        # One-directional: scouting depends on transit, never the reverse
        # (see Cargo.toml's comment on the same dependency).
        "//capabilities/transit:transit_lib",
        "@crate_index//:postgres",
        "@crate_index//:reqwest",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
        "@crate_index//:thiserror",
    ],
)

# Runs the same #[cfg(test)] modules `cargo test` already exercises
# (store/score/vault_linker/opportunity/adapters/config/localtime/
# calendar_promote — `cargo test -- --list` is the current count, per
# README.md#documentation-stays-owned-and-current).
rust_test(
    name = "scouting_test",
    crate = ":scouting",
    size = "small",
)

rust_binary(
    name = "scout",
    srcs = ["src/main.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":scouting",
        # main.rs calls transit::config::Config::load() / transit::store::TransitStore
        # directly (not just through :scouting) -- Bazel needs it declared here too.
        "//capabilities/transit:transit_lib",
        "@crate_index//:serde_json",
    ],
)

# scout-server: scouting's own HTTP API (axum). See
# dashboard/README.md — reopens the
# prior no-server call now that dashboard is a named consumer.
rust_binary(
    name = "scout-server",
    crate_root = "src/server.rs",
    srcs = ["src/server.rs", "//libs/axon-server:src/lib.rs",
        "//libs/route-manifest:src/lib.rs", "//libs/axon-config:src/lib.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":scouting",
        "//capabilities/transit:transit_lib",
        "@crate_index//:axum",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
        "@crate_index//:tokio",
        "@crate_index//:tower-http",
    ],
)
