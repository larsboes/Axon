load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["README.md", "service.toml"])

rust_library(
    name = "finance_lib",
    crate_name = "finance",
    crate_root = "src/lib.rs",
    # Globbed rather than listed — see capabilities/scouting/BUILD.bazel for why the
    # hand-maintained inventory was the drift risk (Axon#13). src/server.rs is excluded
    # because it is the server binary's own crate root.
    srcs = glob(["src/**/*.rs"], exclude = ["src/postgres_test.rs", "src/server.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/axon-config:axon-config",
        "//libs/axon-store:axon-store",
        "//libs/markdown-root:markdown-root",
        "@crate_index//:csv",
        "@crate_index//:postgres",
        "@crate_index//:r2d2",
        "@crate_index//:r2d2_postgres",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
        "@crate_index//:sha2",
    ],
)

rust_test(
    name = "finance_test",
    crate = ":finance_lib",
    size = "small",
)

rust_test(
    name = "finance_postgres_test",
    crate_root = "src/postgres_test.rs",
    srcs = ["src/postgres_test.rs"],
    edition = "2021",
    size = "small",
    tags = [
        "manual",
        "postgres-integration",
    ],
    deps = [
        ":finance_lib",
        "@crate_index//:postgres",
    ],
)

rust_binary(
    name = "finance-server",
    crate_root = "src/server.rs",
    srcs = ["src/server.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":finance_lib",
        "//libs/axon-server:axon-server",
        "//libs/markdown-root:markdown-root",
        "//libs/route-manifest:route-manifest",
        "@crate_index//:axum",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
        "@crate_index//:tokio",
        "@crate_index//:tower-http",
    ],
)

rust_test(
    name = "finance_server_test",
    crate = ":finance-server",
    size = "small",
)
