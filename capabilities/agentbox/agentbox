#!/bin/bash
# capabilities/agentbox/agentbox — run a coding agent inside a disposable container.
# Portable shell only (README.md#portable-shell) — no bash-4-only syntax.
set -euo pipefail

_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../../tools/lib/paths.sh
source "$_dir/../../tools/lib/paths.sh"
# shellcheck source=../../tools/lib/platform.sh
source "$_dir/../../tools/lib/platform.sh"

CONFIG="$AXON_PERSONAL_ROOT/config/agentbox.toml"
DATA="$AXON_PERSONAL_ROOT/data/agentbox"

usage() {
  cat <<'EOF'
Usage:
  agentbox run [--project <dir>] [--online] [-- <agent args>...]
  agentbox build [--no-cache]        # fetch + verify the agent archive, build the image
  agentbox doctor                    # runtime, network, image, config, model endpoint
  agentbox shell [--project <dir>]   # a bash prompt in the same box, no agent
  agentbox host-install [--force]    # install the pinned agent on the HOST, checksummed

Without --project the current directory is mounted. That is the only host path the
box can see.

Two network modes, and there is no third one on docker (Q75):
  default    --network none: loopback and nothing else. No DNS, no route, and NO
             model endpoint either — the agent cannot answer in this mode.
  --online   the default bridge: the internet, and the model server on the host
             at host.docker.internal. This is the only mode the agent works in.

host-install places the same pinned, checksummed release the box runs, plus a shim that
refuses the agent's own self-update verbs — that path is how this machine once moved past
a pin unnoticed (upstreams.toml, Axon#126).
EOF
}

die() { echo "agentbox: $*" >&2; exit 1; }

# --- config ----------------------------------------------------------------

require_config() {
  [ -f "$CONFIG" ] || die "no config at $CONFIG — copy capabilities/agentbox/agentbox.toml.example there and fill it in"
  AGENT="$(toml_get agent "$CONFIG")"
  [ -n "$AGENT" ] || die "$CONFIG has no 'agent'"
  PROFILE_DIR="$_dir/profiles/$AGENT"
  PROFILE="$PROFILE_DIR/profile.toml"
  [ -f "$PROFILE" ] || die "unknown agent '$AGENT' — no $PROFILE"

  VERSION="$(toml_get version "$PROFILE")"
  IMAGE="agentbox-$AGENT:$VERSION"
  AGENT_DIR="$DATA/$AGENT"
  CACHE="$DATA/cache"

  case "$(uname -m)" in
    arm64|aarch64) ARCH="arm64" ;;
    x86_64)        ARCH="x64" ;;
    *)             die "unsupported host arch $(uname -m)" ;;
  esac
  # The box is a Linux container regardless of what builds it, so its target OS is a
  # constant, not `uname -s`. It is a variable anyway because the same pinned release
  # is also installed on the host, where the target is darwin — one profile, one pin,
  # two targets. Callers that want the host build set OS before calling.
  OS="${OS:-linux}"
  ARCHIVE_SHA="$(toml_get "archive_sha256_${OS}_${ARCH}" "$PROFILE")"
  [ -n "$ARCHIVE_SHA" ] || die "$PROFILE has no archive_sha256_${OS}_${ARCH} — add the checksum for this os/arch from the release's SHA256SUMS"
  ARCHIVE_URL="$(toml_get archive_url "$PROFILE")"
  ARCHIVE_URL="${ARCHIVE_URL//\{version\}/$VERSION}"
  ARCHIVE_URL="${ARCHIVE_URL//\{os\}/$OS}"
  ARCHIVE_URL="${ARCHIVE_URL//\{arch\}/$ARCH}"
  ARCHIVE_NAME="$AGENT-$VERSION-$OS-$ARCH.tar.gz"
}

# docker only, and podman is refused by name rather than accepted untested. The two CLIs
# agree on `run`, `build` and `image inspect`, but this capability's claim is isolation and
# nothing here has measured podman's. It also spells the host `host.containers.internal`,
# which model_base_url below would have to branch on. tools/service-runner.sh still takes
# podman, where the claim is only that a container runs.
#
# `command -v docker` earns its line on macOS: OrbStack installs the CLI at
# ~/.orbstack/bin/docker, which a login shell has on PATH and a launchd or cron environment
# does not.
require_runtime() {
  [ "$AXON_CONTAINER_RUNTIME" = "docker" ] \
    || die "container_runtime is '$AXON_CONTAINER_RUNTIME'; agentbox needs docker (Q75 retired apple-container on 2026-09-02; podman's network semantics are unmeasured here)"
  command -v docker >/dev/null 2>&1 \
    || die "'docker' not found on PATH — OrbStack installs it at ~/.orbstack/bin/docker, which a non-login environment does not have (PATH=$PATH)"
  docker info >/dev/null 2>&1 || die "the docker daemon is not answering — start it ('open -a OrbStack' for OrbStack)"
}

# The model API key never reaches a command line or this script's environment as a
# literal; it is read from the overlay's gitignored env file at render time only.
read_api_key() {
  key_file="$(toml_get api_key_file "$CONFIG")"
  key_file="${key_file:-config/agentbox.env}"
  key_var="$(toml_get api_key_var "$CONFIG")"
  key_var="${key_var:-AGENTBOX_MODEL_API_KEY}"
  key_path="$AXON_PERSONAL_ROOT/$key_file"
  if [ ! -f "$key_path" ]; then
    die "no $key_path — create it with '$key_var=<your model server key>' (chmod 600). Never generated here (README.md#secrets)"
  fi
  # \042 = ", \047 = ' — strip either style of quoting around the value.
  API_KEY="$(grep -E "^$key_var=" "$key_path" | head -n1 | cut -d= -f2- | tr -d '\042\047')"
  [ -n "$API_KEY" ] || die "$key_path has no $key_var"
}

# --- network ---------------------------------------------------------------
#
# Two modes and no third one. Measured 2026-09-02 on this Mac, docker 29.4.0 / OrbStack
# 2.2.3, from the debian-trixie agentbox image:
#
#   --network none      only `lo`, no route table at all. TCP to 1.1.1.1:443 fails in
#                       under 1 ms with ENETUNREACH; a DNS lookup fails in ~2 ms rather
#                       than burning a timeout, so no --dns flag is needed. The host is
#                       unreachable too, and that is the cost.
#   default bridge      192.168.215.0/24 with a default route: the whole internet, plus
#                       the Mac at host.docker.internal (0.250.250.254 here).
#
# There is nothing between them. `docker network create --internal` blocks egress and the
# host alike: no default route, no host.docker.internal, host-gateway unreachable. That is
# what apple-container's host-only network did give — its gateway WAS the Mac — and it is
# the property Q75 traded away. See capabilities/agentbox/README.md.
#
# `--add-host host.docker.internal:host-gateway` is redundant on OrbStack, which publishes
# the name itself, and is what makes the same launcher work on a plain Linux daemon, which
# does not. Cheap, and it keeps one spelling of the host in this file.
MODEL_HOST="host.docker.internal"
ONLINE_NET_ARGS="--network bridge --add-host $MODEL_HOST:host-gateway"
# One spelling per mode, because `doctor` proves the closed mode by RUNNING this string. A
# second literal there would let the check stay green while cmd_run handed the box a network.
OFFLINE_NET_ARGS="--network none"

# Ask the endpoint for a status line from inside a throwaway box, on the same network an
# --online box gets. From inside and not with a curl from the host, because the question is
# whether a CONTAINER can reach the server — a host-side curl answers whether the server is
# up, which is a different thing and passes when the server is bound to loopback only.
# Empty output means no answer.
#
# Stated because it changed on 2026-09-02 (Q75): this probe now runs on the OPEN
# network. Under apple-container it ran on the host-only one and could not leave the Mac; the
# bridge has full egress, so a `model_base_url` override naming an off-machine endpoint makes
# `agentbox doctor` send one request there. The probe must share the box's network to answer
# the question at all, and there is no closed docker network that still reaches the host.
probe_model() {
  url="$1"
  hostport="${url#http://}"; hostport="${hostport%%/*}"
  host="${hostport%%:*}"; port="${hostport##*:}"
  # shellcheck disable=SC2086
  docker run --rm $ONLINE_NET_ARGS \
    --entrypoint /bin/bash "$IMAGE" -c "
      exec 3<>/dev/tcp/$host/$port 2>/dev/null || exit 1
      printf 'GET /v1/models HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n\r\n' '$hostport' >&3
      head -n1 <&3
    " 2>/dev/null | tr -d '\r' | grep '^HTTP/' | head -n1
}

# One endpoint, rendered the same way in both modes. The offline box gets a URL it cannot
# reach, and its rendered network statement says exactly that — which is honest, where a
# second URL per mode would only move the surprise later.
model_base_url() {
  override="$(toml_get model_base_url "$CONFIG")"
  if [ -n "$override" ]; then echo "$override"; return; fi
  port="$(toml_get model_port "$CONFIG")"; port="${port:-8000}"
  echo "http://$MODEL_HOST:$port/v1"
}

# --- build -----------------------------------------------------------------

fetch_archive() {
  mkdir -p "$CACHE"
  archive="$CACHE/$ARCHIVE_NAME"
  if [ ! -f "$archive" ]; then
    echo "agentbox: fetching $ARCHIVE_URL"
    curl -fsSL --proto '=https' --tlsv1.2 -o "$archive.part" "$ARCHIVE_URL" || die "download failed"
    mv "$archive.part" "$archive"
  fi
  actual="$(shasum -a 256 "$archive" | cut -d' ' -f1)"
  if [ "$actual" != "$ARCHIVE_SHA" ]; then
    rm -f "$archive"
    die "checksum mismatch for $ARCHIVE_NAME
  expected $ARCHIVE_SHA (profiles/$AGENT/profile.toml)
  got      $actual
The cached copy was deleted. If this repeats, the release was re-cut or the download is not what upstream published."
  fi
  echo "agentbox: sha256 ok — $ARCHIVE_NAME"
}

cmd_build() {
  require_config; require_runtime
  no_cache=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-cache) no_cache="--no-cache"; shift ;;
      *) die "unknown option $1" ;;
    esac
  done
  fetch_archive
  # The build context is the archive cache, so the 100 MB agent tarball is the only
  # thing shipped to the builder — not the whole repo.
  # shellcheck disable=SC2086
  docker build $no_cache \
    --tag "$IMAGE" \
    --file "$_dir/Containerfile" \
    --build-arg "AGENT_NAME=$AGENT" \
    --build-arg "ARCHIVE=$ARCHIVE_NAME" \
    --build-arg "ARCHIVE_ROOT=$(toml_get archive_root "$PROFILE")" \
    --build-arg "BIN_PATH=$(toml_get bin_path "$PROFILE")" \
    --build-arg "ARCHIVE_SHA256=$ARCHIVE_SHA" \
    --build-arg "AGENT_UID=$(id -u)" \
    --build-arg "AGENT_GID=$(id -g)" \
    "$CACHE"
  echo "agentbox: built $IMAGE"
}

# --- config rendering ------------------------------------------------------

# Rendered fresh on every run: Axon owns the contract, the overlay owns the instance
# values and whatever the agent itself writes next to them (sessions, caches, trust).
render_config_dir() {
  mkdir -p "$AGENT_DIR"
  chmod 700 "$AGENT_DIR"

  base_url="$(model_base_url)"
  read_api_key
  network_statement="$1"

  for target in $(toml_array render "$PROFILE"); do
    tmpl="$PROFILE_DIR/$target.tmpl"
    [ -f "$tmpl" ] || die "profile declares render=$target but $tmpl is missing"
    out="$AGENT_DIR/$target"
    sed \
      -e "s|{{MODEL_BASE_URL}}|$base_url|g" \
      -e "s|{{MODEL_ID}}|$(toml_get model_id "$CONFIG")|g" \
      -e "s|{{MODEL_NAME}}|$(toml_get model_name "$CONFIG")|g" \
      -e "s|{{MODEL_CONTEXT_WINDOW}}|$(toml_get model_context_window "$CONFIG")|g" \
      -e "s|{{MODEL_MAX_TOKENS}}|$(toml_get model_max_tokens "$CONFIG")|g" \
      -e "s|{{NETWORK_STATEMENT}}|$network_statement|g" \
      "$tmpl" > "$out.part"
    # The key lands last and via a separate pass, so it never appears in an error
    # message from the substitutions above. `&` and `|` would otherwise be read as
    # sed syntax rather than as key material.
    esc_key="$(printf '%s' "$API_KEY" | sed -e 's/[&|\\]/\\&/g')"
    sed -e "s|{{MODEL_API_KEY}}|$esc_key|g" "$out.part" > "$out"
    rm -f "$out.part"
    chmod 600 "$out"
  done

  if [ -d "$PROFILE_DIR/extensions" ]; then
    rm -rf "$AGENT_DIR/extensions"
    cp -R "$PROFILE_DIR/extensions" "$AGENT_DIR/extensions"
  fi
}

# --- run -------------------------------------------------------------------

cmd_run() {
  require_config; require_runtime
  project="$PWD"
  online=0
  entry_shell=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) project="$2"; shift 2 ;;
      --online) online=1; shift ;;
      --shell) entry_shell=1; shift ;;
      --) shift; break ;;
      -h|--help) usage; exit 0 ;;
      *) break ;;
    esac
  done

  [ -d "$project" ] || die "no such project directory: $project"
  project="$(cd "$project" && pwd)"
  case "$project" in
    "$HOME"|/) die "refusing to mount '$project' — point --project at one project, not your home" ;;
  esac

  docker image inspect "$IMAGE" >/dev/null 2>&1 || die "no image $IMAGE — run 'agentbox build'"

  if [ "$online" -eq 1 ]; then
    net_args="$ONLINE_NET_ARGS"
    statement="this box has internet access (--online), and it is also the only mode in which the model endpoint on the host answers. Treat every outbound call as something you must be able to justify."
  else
    net_args="$OFFLINE_NET_ARGS"
    statement="none at all. This box has no network interface but loopback: no DNS, no route off the machine, and no model endpoint either. git push, package installs, web fetches AND model calls all fail. That is intended; --online is the mode that has a model."
    # Said out loud rather than discovered when the agent's first turn errors. The default
    # is still the closed one: the safe mode losing a capability is not a reason to make
    # the open mode the one you get by not thinking about it.
    [ "$entry_shell" -eq 1 ] \
      || echo "agentbox: offline box — the model at $(model_base_url) is NOT reachable from it. Use 'agentbox run --online' for a working agent (Q75)." >&2
  fi

  render_config_dir "$statement"

  config_dir="$(toml_get config_dir "$PROFILE")"
  # --memory is a hard cgroup limit and the box sees it. --cpus is a CFS quota and the box
  # does NOT: measured 2026-09-02, `--cpus 4` leaves `nproc` reporting all 12 host cores
  # while cpu.max says 400000/100000. Anything inside that sizes its own parallelism off
  # nproc will over-subscribe and get throttled rather than refused. apple-container gave
  # the box a VM with the declared vCPU count, so this is a behaviour change, not a bug.
  cpus="$(toml_get cpus "$CONFIG")"; cpus="${cpus:-4}"
  memory="$(toml_get memory "$CONFIG")"; memory="${memory:-4G}"

  # The profile's model selection is a default, not a fixture: it is prepended unless the
  # caller named a model or provider themselves, so `run -- -p "..."` still lands on the
  # configured model while `run -- --model other` still wins.
  caller_picked_model=0
  for arg in ${1+"$@"}; do
    case "$arg" in --model|-m|--provider|--models) caller_picked_model=1 ;; esac
  done
  if [ "$entry_shell" -eq 0 ] && [ "$caller_picked_model" -eq 0 ]; then
    model_args="$(toml_get model_args "$PROFILE")"
    model_args="${model_args//\{model_id\}/$(toml_get model_id "$CONFIG")}"
    # shellcheck disable=SC2086
    set -- $model_args ${1+"$@"}
  fi

  entrypoint_args=""
  [ "$entry_shell" -eq 1 ] && entrypoint_args="--entrypoint /bin/bash"

  # A tty is only allocatable when there is one to attach to; asking for one from a
  # script or a pipe fails the run outright (ENODEV), which would rule out `-p` prompts
  # and any non-interactive use.
  tty_args="--interactive"
  [ -t 0 ] && tty_args="--interactive --tty"

  # `exec` on purpose: the box IS this process from here on, so signals, the exit code and
  # the tty pass through unmediated. Nothing needs tearing down after it — `--rm` covers the
  # container, and neither mode creates a network, a volume or a second container.
  # shellcheck disable=SC2086
  exec docker run --rm $tty_args \
    $net_args $entrypoint_args \
    --cpus "$cpus" --memory "$memory" \
    --volume "$AGENT_DIR:$config_dir" \
    --volume "$project:/workspace" \
    --workdir /workspace \
    --env "$(toml_get config_dir_env "$PROFILE")=$config_dir" \
    --env "$(toml_get env_offline "$PROFILE")" \
    --env "$(toml_get env_telemetry "$PROFILE")" \
    "$IMAGE" ${1+"$@"}
}

# --- what host-install refuses ---------------------------------------------
#
# Axon#126. Every other check in this repo describes a version the manifest names. A
# self-updating binary replaces the thing on disk without consulting any of them, so the pin
# and the checksum end up describing software the machine stopped running. That is not
# hypothetical here: upstreams.toml's pi-coding-agent entry records the host self-updating via
# `pi update` about 15h after a release, and the pin was written afterwards to describe an
# adoption that had already happened.
#
# There was a separate `agentbox gate` verb here until 2026-09-02. It held two checks: a
# published-GHSA lookup, retired on 2026-08-28 with tools/lib/advisories.sh (PRD Q41), and a
# cooldown on the release's age, retired by Q74. With both gone it refused nothing — it
# resolved a repository, printed two lines and returned 0 — and a verb that cannot say no is
# how a green step comes to read as a passed check. What still refuses is the sha256 in
# fetch_archive above, on the install path, unchanged.

# Resolve the upstream repo this profile's agent comes from, via profile.toml's declared
# upstreams.toml section. Empty output means the profile did not declare one.
upstream_repo() {
  local section url
  section="$(toml_get upstream "$PROFILE")"
  [ -n "$section" ] || return 1
  url="$(toml_get_in "$section" url "$AXON_ROOT/upstreams.toml")"
  [ -n "$url" ] || return 1
  printf '%s' "$url" | sed -E 's#.*github.com/([^/]+/[^/]+).*#\1#; s#\.git$##'
}

# --- host install ----------------------------------------------------------

HOST_ROOT_DEFAULT() { printf '%s' "$DATA/host"; }

cmd_host_install() {
  force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      *) die "unknown option $1" ;;
    esac
  done

  # The host is whatever this machine is, unlike the box, which is Linux by construction.
  # Set before require_config, which reads archive_sha256_${OS}_${ARCH} and defaults OS to
  # the box's target — the one place where "the same pin, two targets" has to be told apart.
  case "$(uname -s)" in
    Darwin) OS="darwin" ;;
    Linux)  OS="linux" ;;
    *) die "unsupported host os $(uname -s)" ;;
  esac
  export OS
  require_config

  # Advisories are a human's, and this says so at the moment of use rather than going quiet.
  # PRD Q41 retired tools/lib/advisories.sh on 2026-08-28 and nothing standard replaces it for
  # THIS dependency: the agent arrives as a pinned release tarball, so no ecosystem lockfile
  # names it and neither Dependabot alerts nor osv-scanner will ever see it. The cooldown half
  # of this check went on 2026-09-02 (Q74) — it asked how OLD the bytes were; the sha256 in
  # fetch_archive asks WHAT they are, and that one still refuses.
  repo="$(upstream_repo)" || die "profile $PROFILE declares no 'upstream' — cannot name the advisory list (Axon#126)"
  echo "agentbox: advisories are NOT checked here — open the list before you accept:"
  echo "    https://github.com/$repo/security/advisories"
  echo "  (capabilities/agentbox/README.md#what-host-install-refuses explains why this is manual)"

  host_root="$(HOST_ROOT_DEFAULT)"
  versioned="$host_root/versions/$AGENT-$VERSION"
  shim="$host_root/bin/$AGENT"

  if [ -x "$versioned/$(toml_get bin_path "$PROFILE")" ] && [ "$force" -eq 0 ]; then
    echo "agentbox: $AGENT $VERSION already installed at $versioned (--force to redo)"
  else
    fetch_archive     # same cache, same sha256 check, same failure message as the box build
    mkdir -p "$versioned"
    tar xzf "$CACHE/$ARCHIVE_NAME" -C "$versioned" --strip-components=1 \
      "$(toml_get archive_root "$PROFILE")" || die "extract failed"
    chmod 755 "$versioned/$(toml_get bin_path "$PROFILE")"
    echo "agentbox: installed $AGENT $VERSION → $versioned"
  fi

  # `current` is a symlink so the shim never has to be rewritten to move versions, and so
  # what is running is one readlink away rather than a guess.
  mkdir -p "$host_root/bin"
  rm -f "$host_root/current"
  ln -s "$versioned" "$host_root/current"

  write_shim "$shim"
  echo "agentbox: shim → $shim"
  echo
  echo "Add it to PATH ahead of any other $AGENT, then the self-update path is gated:"
  echo "  export PATH=\"$host_root/bin:\$PATH\""
  echo "Axon does not edit your shell config; that is a machine fact and belongs to you."
}

# The shim: upstream semantics preserved for every verb except the ones that replace the
# binary in place. Those are declared in profile.toml, not hardcoded here — a different agent
# spells them differently, and an unlisted verb must reach upstream unchanged.
write_shim() {
  local out="$1" verbs
  # toml_array is one element per line; the shim wants a case-pattern alternation.
  verbs="$(toml_array self_update_verbs "$PROFILE" | tr '\n' '|' | sed 's/|$//')"
  [ -n "$verbs" ] || die "$PROFILE declares no self_update_verbs — refusing to write a shim that gates nothing"
  mkdir -p "$(dirname "$out")"
  {
    printf '#!/bin/bash\n'
    printf '# Generated by `agentbox host-install` — do not edit; re-run host-install instead.\n'
    printf '# Axon#126: the agent may do anything except replace itself behind the gate.\n'
    printf 'set -euo pipefail\n'
    printf 'REAL="%s/current/%s"\n' "$(HOST_ROOT_DEFAULT)" "$(toml_get bin_path "$PROFILE")"
    printf 'case "${1:-}" in\n'
    printf '  %s)\n' "$verbs"
    printf '    echo "%s: self-update is gated by Axon (upstreams.toml pins this version)." >&2\n' "$AGENT"
    printf '    echo "  Use: agentbox host-install   — after bumping version + archive_sha256_* in" >&2\n'
    printf '    echo "       capabilities/agentbox/profiles/%s/profile.toml and upstreams.toml." >&2\n' "$AGENT"
    printf '    echo "  That path verifies the pinned archive'"'"'s sha256; this one does not." >&2\n'
    printf '    exit 1 ;;\n'
    printf 'esac\n'
    printf 'exec "$REAL" "$@"\n'
  } > "$out"
  chmod 755 "$out"
}

# --- doctor ----------------------------------------------------------------

ok()   { echo "  ✓ $*"; }
bad()  { echo "  ✗ $*"; DOCTOR_FAILED=1; }

cmd_doctor() {
  DOCTOR_FAILED=0
  echo "agentbox"

  # The runtime verdict comes first because it needs nothing from the profile. require_config
  # dies when the profile has no checksum for this host's arch (x86_64 CI runners, since the
  # pinned pi release is arm64-only), and a doctor that has to fetch a checksum before it can
  # say "wrong runtime" answers the cheap question last.
  # Three separate causes, three separate lines. Reporting them as one ("not available")
  # was the old shape, and it sends a machine that declares the wrong runtime looking for a
  # missing binary.
  runtime_ok=0
  if [ "$AXON_CONTAINER_RUNTIME" != "docker" ]; then
    bad "runtime: machine.toml declares container_runtime = '$AXON_CONTAINER_RUNTIME'; agentbox needs docker (Q75; podman's network semantics are unmeasured here)"
  elif ! command -v docker >/dev/null 2>&1; then
    bad "runtime: 'docker' not on PATH — OrbStack installs it at ~/.orbstack/bin/docker, which a non-login environment does not have"
  elif ! docker info >/dev/null 2>&1; then
    bad "runtime: the docker daemon is not answering — start it ('open -a OrbStack' for OrbStack)"
  else
    runtime_ok=1
    ok "runtime: docker $(docker version --format '{{.Server.Version}}' 2>/dev/null) on $(docker info --format '{{.OperatingSystem}}' 2>/dev/null)"
  fi
  require_config
  ok "agent: $AGENT $VERSION (profiles/$AGENT/profile.toml)"

  # Everything below asks the runtime a question, so a machine without one gets "not checked"
  # rather than an answer obtained from a daemon it does not declare.
  have_image=0
  if [ "$runtime_ok" -eq 0 ]; then
    bad "image: not checked — no usable runtime to ask"
  elif docker image inspect "$IMAGE" >/dev/null 2>&1; then
    have_image=1
    ok "image: $IMAGE"
  else
    bad "image: $IMAGE missing — 'agentbox build'"
  fi

  # The isolation claim, checked rather than asserted. There is no persistent network to
  # inspect any more, so what doctor can report is the property itself: a --network none box
  # built from THIS image reaches nothing. Falsifiable in about a second, which is the only
  # kind of check worth printing.
  if [ "$have_image" -eq 0 ]; then
    bad "network: not checked — needs the image to check from"
  # shellcheck disable=SC2086
  elif docker run --rm $OFFLINE_NET_ARGS --entrypoint /bin/bash "$IMAGE" \
         -c 'exec 3<>/dev/tcp/1.1.1.1/443' >/dev/null 2>&1; then
    bad "network: a box on '$OFFLINE_NET_ARGS' reached 1.1.1.1:443 — the offline mode is not isolating"
  else
    ok "network: offline mode is '$OFFLINE_NET_ARGS' (loopback only: no route, no resolver, no host)"
  fi

  url="$(model_base_url 2>/dev/null || true)"
  if [ "$have_image" -eq 0 ]; then
    bad "model: not probed — needs the image to probe from"
  else
    status="$(probe_model "$url" || true)"
    host="${url#http://}"; host="${host%%:*}"
    if [ -n "$status" ]; then
      # Any status line is a pass: doctor asks whether the endpoint is reachable, and
      # a 401 answers that as well as a 200 does.
      ok "model: $url answers from an --online box ($status)"
    else
      bad "model: silence at $url from inside an --online box.
      A container cannot reach the host's 127.0.0.1 — the server has to bind 0.0.0.0, and
      $host has to be among the Host headers it accepts. Only 'agentbox run --online'
      reaches it at all; the default box has no network (Q75)."
    fi
  fi

  key_file="$(toml_get api_key_file "$CONFIG")"; key_file="${key_file:-config/agentbox.env}"
  if [ -f "$AXON_PERSONAL_ROOT/$key_file" ]; then
    ok "key: $key_file present"
  else
    bad "key: $key_file missing — see the README's Setup section"
  fi

  [ "$DOCTOR_FAILED" -eq 0 ] || exit 1
}

# --- dispatch --------------------------------------------------------------

cmd="${1:-}"
[ $# -gt 0 ] && shift || true
case "$cmd" in
  build)        cmd_build "$@" ;;
  run)          cmd_run "$@" ;;
  shell)        cmd_run --shell "$@" ;;
  doctor)       cmd_doctor ;;
  host-install) cmd_host_install "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command '$cmd'" ;;
esac
