load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# README.md is otherwise private to this package -- exported so the root
# //:architecture_up_to_date_test and //:manifest_integrity_test can reference
# it across the package boundary (same as scouting/transit/axon-status). Adding
# this BUILD.bazel makes capabilities/comms its own Bazel package, so the root
# `capabilities/*/README.md` glob can no longer reach it -- hence the explicit
# labels added to _ARCHITECTURE_INPUTS and _MANIFEST_INPUTS in the root
# BUILD.bazel.
exports_files(["README.md", "service.toml"])

# Rust dependencies come from the root workspace's @crate_index repository.
# Direct dependencies remain declared here in comms/Cargo.toml. Store tests
# additionally need the shared local Postgres (capabilities/postgres).

rust_library(
    name = "comms",
    # Explicit, not inferred: srcs now carries a second file named lib.rs
    # (a shared library), and rules_rust's crate-root inference picks by
    # basename -- it chose axon-config's, and the resulting rlib exposed none of
    # this crate's modules while still "building successfully". Every sibling
    # that includes a lib names its crate_root for the same reason.
    crate_root = "src/lib.rs",
    # Globbed rather than listed — see capabilities/scouting/BUILD.bazel for why the
    # hand-maintained inventory was the drift risk (Axon#13). This package is the second
    # instance: relevance.rs and vault_links.rs were hand-added in 2026-07 after scouting's
    # list had already gone stale once. Binary roots excluded because they are their own
    # crates; the //libs source stays explicit because a glob cannot cross a package
    # boundary.
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs", "src/server.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/axon-config:axon-config",
        "//libs/content-item:content-item",
        "//libs/axon-store:axon-store",
        "//libs/inference:inference",
        "//libs/summarize:summarize",
        "@crate_index//:base64",
        "@crate_index//:postgres",
        "@crate_index//:r2d2",
        "@crate_index//:r2d2_postgres",
        "@crate_index//:reqwest",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
        "@crate_index//:sha2",
        "@crate_index//:thiserror",
        # The extraction work put both of these in the library rather than only
        # the server binary, and Cargo.toml already declares them — bazel just
        # had not been told. Without them the lib fails to compile under bazel
        # while `cargo build` succeeds, which reads as a bazel bug and is not.
        "@crate_index//:tokio",
        "@crate_index//:xberg",
    ],
)

# Runs every hermetic #[cfg(test)] module. The store module is filtered here
# and selected by comms_postgres_test below, so the two targets compile the
# same crate but make different service requirements explicit.
rust_test(
    name = "comms_test",
    args = [
        "--skip",
        "store::tests::",
    ],
    crate = ":comms",
    data = glob(["eval/**"]),
    size = "small",
)

rust_test(
    name = "comms_postgres_test",
    args = ["store::tests::"],
    crate = ":comms",
    data = glob(["eval/**"]),
    size = "small",
    tags = [
        "manual",
        "postgres-integration",
    ],
)

# Bazel forbids a binary and library sharing one target name (cargo allows it),
# so the CLI target is comms-cli here while the cargo-built binary stays `comms`
# — same split as scouting (lib `scouting`, bin `scout`).
rust_binary(
    name = "comms-cli",
    srcs = ["src/main.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":comms",
        "@crate_index//:serde_json",
    ],
)

# comms-server: comms's own HTTP API (axum). Same dashboard-consumer rationale
# as scout-server -- see dashboard/README.md.
rust_binary(
    name = "comms-server",
    crate_root = "src/server.rs",
    srcs = ["src/server.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":comms",
        "//libs/axon-server:axon-server",
        "//libs/route-manifest:route-manifest",
        "@crate_index//:axum",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
        "@crate_index//:tokio",
        "@crate_index//:tower-http",
    ],
)

rust_binary(
    name = "comms-extraction-eval",
    srcs = ["src/extraction_eval_main.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [":comms"],
)
