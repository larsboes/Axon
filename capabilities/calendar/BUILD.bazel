load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["README.md", "service.toml"])

rust_library(
    name = "calendar_lib",
    crate_name = "calendar",
    crate_root = "src/lib.rs",
    # Globbed rather than listed — see capabilities/scouting/BUILD.bazel for why the
    # hand-maintained inventory was the drift risk (Axon#13). src/server.rs is excluded
    # because it is the server binary's own crate root.
    srcs = glob(["src/**/*.rs"], exclude = ["src/server.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/axon-config:axon-config",
        "//libs/content-item:content-item",
        "//libs/markdown-root:markdown-root",
        "//libs/axon-store:axon-store",
        "@crate_index//:postgres",
        "@crate_index//:r2d2",
        "@crate_index//:r2d2_postgres",
        # Phase E's Google Calendar transport. Blocking client, matching the
        # synchronous `postgres` client the rest of this crate uses; only the
        # server binary carries a tokio runtime.
        "@crate_index//:reqwest",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
    ],
)

rust_test(
    name = "calendar_test",
    crate = ":calendar_lib",
    size = "small",
)

rust_binary(
    name = "calendar-server",
    crate_root = "src/server.rs",
    srcs = ["src/server.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":calendar_lib",
        "//libs/axon-server:axon-server",
        "//libs/route-manifest:route-manifest",
        "@crate_index//:axum",
        "@crate_index//:reqwest",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
        "@crate_index//:tokio",
        "@crate_index//:tower-http",
    ],
)
