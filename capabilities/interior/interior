#!/usr/bin/env bun
/**
 * interior — indoor planning for the 33 m² flat.
 *
 * Reads the measured model in data/wohnung/model/, builds it as a Pascal scene the agent can
 * manipulate and a browser can show, and judges layouts against constraints.yaml.
 *
 * `check` exits non-zero when a hard rule is violated, so it works as a gate.
 */

import { Pascal, editorEndpoints } from "./src/pascal.ts";
import { buildScene, exportScene } from "./src/scene.ts";
import { checkLayout, type CheckResult } from "./src/clearance.ts";
import { loadFurniture, loadLayout, loadRoom, uncertainties } from "./src/model.ts";
import { LAYOUTS_DIR, MODEL_DIR, OUT_DIR } from "./src/paths.ts";
import { renderPage } from "./src/page.ts";
import { join } from "node:path";
import { mkdir } from "node:fs/promises";

const argv = process.argv.slice(2);
const cmd = argv[0];

function flag(name: string): string | undefined {
  const i = argv.indexOf(`--${name}`);
  return i >= 0 ? argv[i + 1] : undefined;
}

const bold = (s: string) => `\x1b[1m${s}\x1b[0m`;
const dim = (s: string) => `\x1b[2m${s}\x1b[0m`;
const red = (s: string) => `\x1b[31m${s}\x1b[0m`;
const yellow = (s: string) => `\x1b[33m${s}\x1b[0m`;
const green = (s: string) => `\x1b[32m${s}\x1b[0m`;

function usage(): never {
  console.log(`
${bold("interior")} — indoor planning for the 33 m² flat

  ${bold("model")}                     the measured room, and what in it is still a guess
  ${bold("build")}  [--layout <name>]  build the scene headlessly and report what landed
  ${bold("check")}  <layout>           judge a layout against constraints.yaml (exit 1 on a hard violation)
  ${bold("open")}   [--layout <name>]  build and save it browser-visible, print the URL
  ${bold("export")} [--layout <name>]  write the scene JSON for the render step
  ${bold("layouts")}                   list the layouts on disk
  ${bold("tools")}                     list the Pascal tools available (diagnostic)

Model: ${dim(MODEL_DIR)}
`);
  process.exit(1);
}

function reportCheck(r: CheckResult): void {
  const status = r.pass ? green("PASS") : red("FAIL");
  console.log(`\n${bold(r.layout)}  ${status}\n`);

  if (r.hard.length) {
    console.log(red(bold(`  ${r.hard.length} hard violation${r.hard.length > 1 ? "s" : ""}`)));
    for (const v of r.hard) console.log(`    ${red("✗")} ${bold(v.rule)}  ${v.message}`);
    console.log();
  }
  if (r.soft.length) {
    console.log(yellow(bold(`  ${r.soft.length} soft warning${r.soft.length > 1 ? "s" : ""}`)));
    for (const v of r.soft) console.log(`    ${yellow("!")} ${bold(v.rule)}  ${v.message}`);
    console.log();
  }
  if (!r.hard.length && !r.soft.length) console.log(green("  no violations\n"));

  const m = r.metrics;
  console.log(bold("  space"));
  console.log(`    room ${m.roomAreaM2.toFixed(2)} m²   occupied ${m.occupiedAreaM2.toFixed(2)} m²   free ${m.freeAreaM2.toFixed(2)} m²`);
  for (const c of m.corridors) {
    const w = c.widthCm == null ? red("blocked") : `${c.widthCm} cm`;
    console.log(`    ${c.from} → ${c.to}: ${w}`);
  }

  if (r.uncertainties.length) {
    console.log(`\n${yellow(bold("  measured? no."))}`);
    for (const u of r.uncertainties) {
      console.log(`    ${u.label} — ${u.fields.join(", ")} ${u.note ? dim(`(${u.note})`) : ""}`);
    }
    console.log(dim("    Every number above inherits these guesses."));
  }
  console.log();
}

async function main() {
  switch (cmd) {
    case "model": {
      const [room, cat] = await Promise.all([loadRoom(), loadFurniture()]);
      console.log(`\n${bold("Wohnung, 33 m² Exposé")}\n`);
      console.log(`  plannable   ${room.areaM2.toFixed(2)} m²  ${dim("(polygon, computed)")}`);
      console.log(`  height      ${room.hoehe ?? red("not measured")}`);
      console.log(`  walls       ${Object.keys(room.waende).join(", ")}`);
      console.log(`  openings    ${room.oeffnungen.map((o) => o.id).join(", ")}`);
      console.log(`  fixed       ${room.fixMoebel.map((f) => f.id).join(", ") || "none"}`);
      console.log(`  catalogue   ${cat.size} items`);
      if (room.todoAufmass.length) {
        console.log(`\n${yellow(bold("  still to measure"))}`);
        for (const t of room.todoAufmass) console.log(`    · ${t}`);
      }
      const u = uncertainties(cat);
      if (u.length) {
        console.log(`\n${yellow(bold("  estimated dimensions"))}`);
        for (const x of u) console.log(`    · ${x.label} — ${x.fields.join(", ")}`);
      }
      console.log();
      break;
    }

    case "layouts": {
      const g = new Bun.Glob("*.yaml");
      const found = [...g.scanSync({ cwd: LAYOUTS_DIR, onlyFiles: true })];
      console.log(found.length ? found.map((f) => `  ${f.replace(/\.yaml$/, "")}`).join("\n") : "  none yet");
      break;
    }

    case "check": {
      const name = argv[1];
      if (!name) usage();
      const result = await checkLayout(await loadLayout(name));
      reportCheck(result);
      process.exit(result.pass ? 0 : 1);
    }

    case "build": {
      const layoutName = flag("layout");
      const layout = layoutName ? await loadLayout(layoutName) : undefined;
      const p = await Pascal.open();
      try {
        const r = await buildScene(p, { layout });
        console.log(`\n  area      ${bold(`${r.areaM2.toFixed(2)} m²`)}`);
        console.log(`  walls     ${Object.entries(r.walls).map(([n]) => n).join(", ")}`);
        console.log(`  openings  ${r.openings.join(", ")}`);
        console.log(`  items     ${r.items.length ? r.items.map((i) => `${i.ref}(${i.drawn})`).join(", ") : "none"}`);
        for (const w of r.warnings) console.log(`  ${yellow("!")} ${w}`);
        console.log();
      } finally {
        p.close();
      }
      break;
    }

    case "open": {
      const layoutName = flag("layout");
      const layout = layoutName ? await loadLayout(layoutName) : undefined;
      const p = await Pascal.open({ needsStore: true });
      try {
        if (!p.live) {
          console.log(`\n  ${yellow("!")} the editor is not running — start it with ${bold("bunx @pascal-app/cli editor")}`);
          console.log(dim("    without it a scene can be built but not saved anywhere a browser can see."));
          process.exit(1);
        }
        const r = await buildScene(p, { layout });
        const saved = await p.call("save_scene", {
          name: layoutName ? `wohnung — ${layoutName}` : "wohnung",
          saveMode: "draft",
        });
        const id = saved?.id ?? saved?.sceneId;
        console.log(`\n  ${bold(`${r.areaM2.toFixed(2)} m²`)} built, saved as ${id ?? "(no id returned)"}`);
        const ends = await editorEndpoints();
        console.log(`  open  ${bold(`${ends?.editor ?? ""}/editor/${id ?? ""}`)}`);
        for (const w of r.warnings) console.log(`  ${yellow("!")} ${w}`);
        console.log();
      } finally {
        p.close();
      }
      break;
    }

    case "page": {
      // One self-contained HTML file: the layouts as plans, the photographs as camera
      // positions standing on them. Generated rather than written, so the picture and the
      // checker's verdict cannot drift apart.
      const out = flag("out") ?? join(OUT_DIR, "layouts.html");
      const { html, photos, bytes } = await renderPage({
        title: flag("title") ?? "Floor Plans",
        generatedAt: new Date().toISOString().slice(0, 10),
      });
      await mkdir(OUT_DIR, { recursive: true });
      await Bun.write(out, html);
      const mb = (n: number) => `${(n / 1024 / 1024).toFixed(1)} MB`;
      console.log(`\n  wrote ${bold(out)}`);
      console.log(`  ${photos} photos embedded, ${mb(bytes)} of image data, ${mb(html.length)} total`);
      // The page embeds photographs of the inside of a home. It is written to the overlay, which
      // is default-deny gitignored, and it is opened locally. It does not go to a hosted URL.
      console.log(dim("  contains private photos — local file only, do not upload\n"));
      if (argv.includes("--open")) Bun.spawnSync(["open", out]);
      break;
    }

    case "export": {
      const layoutName = flag("layout");
      const layout = layoutName ? await loadLayout(layoutName) : undefined;
      const out = flag("out") ?? join(OUT_DIR, `${layoutName ?? "wohnung"}.scene.json`);
      const p = await Pascal.open();
      try {
        await buildScene(p, { layout });
        const scene = await exportScene(p);
        await mkdir(OUT_DIR, { recursive: true });
        await Bun.write(out, JSON.stringify(scene, null, 2));
        const nodes = Object.values(scene.nodes ?? {}) as Array<{ type?: string }>;
        const count = (t: string) => nodes.filter((n) => n.type === t).length;
        console.log(`\n  wrote ${bold(out)}`);
        console.log(`  ${count("wall")} walls, ${count("door")} doors, ${count("window")} windows, ${count("zone")} zones\n`);
      } finally {
        p.close();
      }
      break;
    }

    case "tools": {
      const p = await Pascal.open();
      try {
        const t = await p.tools();
        console.log(`\n  ${t.length} tools\n`);
        for (const x of t) console.log(`    ${x.name}`);
        console.log();
      } finally {
        p.close();
      }
      break;
    }

    default:
      usage();
  }
}

await main();
