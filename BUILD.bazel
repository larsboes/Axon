# The root package owns only repository-wide gates and entrypoints whose inputs
# cross package boundaries. Architecture, manifest, publication, and audit rules
# stay here so their globs can see root-owned capability and Pack metadata. Tool
# regression tests live in //tools; compatibility aliases below preserve their
# established root labels without returning their implementation ownership here.
#
# Rust capabilities, libraries, dashboard, and tools are separate packages, so
# the repository-wide gates name their exported cross-package inputs explicitly.
# See README.md, "Generated architecture" and "Argue Bazel per case", for why these
# targets exist in Bazel at all.

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Cargo and rules_rust share the workspace inputs here. The remaining exports are
# root-owned public configuration or fixtures consumed by //tools tests.
exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "axon.toml",
    "bootstrap.sh",
    "capabilities/home-assistant/service.toml",
    "capabilities/postgres/service.toml",
    "capabilities/vaultwarden/service.toml",
    "rust-toolchain.toml",
    "upstreams.toml",
])

# Database-backed Rust tests are explicit and manual so `bazel test //...`
# stays usable in a fresh clone without a running Axon Postgres service. The
# suite is the one public entrypoint for CI and contributors who do have the
# synthetic test database available.
test_suite(
    name = "postgres_integration_tests",
    tests = [
        "//capabilities/comms:comms_postgres_test",
        "//capabilities/scouting:scouting_postgres_test",
        "//capabilities/tasks:tasks_postgres_test",
        "//capabilities/transit:transit_postgres_test",
    ],
    tags = ["manual"],
)

_ARCHITECTURE_INPUTS = [
    "axon.toml",
    "upstreams.toml",
    "systems.toml",
    "//tools:lib/paths.sh",
    "//tools:lib/toml.sh",
    # Every subpackage capability needs BOTH labels. README.md feeds the What column;
    # service.toml feeds Service, Port and Panel. Only calendar's service.toml was listed
    # here until 2026-07-30, so the six below were invisible to the generator inside the
    # sandbox — latent while the generator emitted nothing from a process manifest (an
    # em dash either way, so no diff), and immediately visible the moment it started
    # emitting `port` (Axon#39). That is the Axon#30 false-green class, now gated by
    # tools/check-bazel-package-labels.sh, which scopes its search to THIS list — the
    # same labels also appear in //:service_toml_schema_test's data below, and satisfying
    # that target proves nothing about this one.
    "//capabilities/comms:README.md",
    "//capabilities/comms:service.toml",
    "//capabilities/scouting:README.md",
    "//capabilities/scouting:service.toml",
    "//capabilities/transit:README.md",
    "//capabilities/transit:service.toml",
    "//capabilities/trips:README.md",
    "//capabilities/trips:service.toml",
    "//capabilities/axon-status:README.md",
    "//capabilities/axon-status:service.toml",
    "//capabilities/punctuality:README.md",
    "//capabilities/punctuality:service.toml",
    "//capabilities/calendar:README.md",
    "//capabilities/calendar:service.toml",
    "//capabilities/soundscape:README.md",
    "//capabilities/soundscape:service.toml",
    # tasks landed with its own BUILD.bazel but without these two labels, so the
    # sandboxed generator could not see it while a local run could -- the Axon#30
    # false-green class again, caught here by the freshness gate the moment
    # anything else made ARCHITECTURE.md regenerate.
    "//capabilities/tasks:README.md",
    "//capabilities/tasks:service.toml",
    "//libs/ai-client:README.md",
    "//libs/axon-config:README.md",
    "//libs/axon-server:README.md",
    "//libs/axon-store:README.md",
    "//libs/content-item:README.md",
    "//libs/inference:README.md",
    "//libs/markdown-root:README.md",
    "//libs/overlay:README.md",
    "//libs/route-manifest:README.md",
    "//libs/summarize:README.md",
    # The generator discovers spine apps via the root-level */service.toml glob; the
    # sandbox only materializes declared files, so the manifest must be data here or
    # the sandbox regeneration silently loses the dashboard row (caught by this very
    # gate the first time the glob landed without it).
    #
    # Explicit labels rather than globs since 2026-07-31: dashboard/ got its own
    # BUILD.bazel when it was wired into the build graph, which makes it a separate
    # package that a glob from here cannot reach -- the same mechanism spelled out
    # for libs/ below, and it fails loudly at load time rather than silently.
    "//dashboard:README.md",
    "//dashboard:service.toml",
] + glob([
    "capabilities/*/README.md",
    "capabilities/*/service.toml",
    "Packs/*/pack.toml",
])
# libs/*/README.md is NOT globbed: README.md#three-architectural-nouns requires every lib to have its own BUILD.bazel
# from day one, so each one is always a separate Bazel package glob() from here can't
# reach -- add an explicit "//libs/<name>:README.md" label above instead, same as
# capabilities/scouting and capabilities/transit.

sh_binary(
    name = "generate_architecture",
    srcs = ["//tools:generate-architecture.sh"],
    data = _ARCHITECTURE_INPUTS,
)

sh_test(
    name = "architecture_up_to_date_test",
    size = "small",
    srcs = ["//tools:check-architecture-fresh.sh"],
    data = _ARCHITECTURE_INPUTS + [
        "ARCHITECTURE.md",
        "//tools:generate-architecture.sh",
    ],
)

# Rebuilds the local code-dependency graph via graphify (upstreams.toml [graphify]).
# `bazel run //:graphify`, mirroring generate_architecture above -- but this one's
# output (graphify-out/) is git-ignored, not committed: see
# tools/graphify.sh.
sh_binary(
    name = "graphify",
    srcs = ["//tools:graphify.sh"],
    data = [
        "//tools:lib/paths.sh",
        "//tools:lib/toml.sh",
    ],
)

# The self-reference class from the decisions/ dissolution's link rewriter:
# a doc citing its own path as if pointing somewhere else. Scope = the same
# README/manifest set the architecture gate already materializes, plus the
# Pack docs where the 2026-07-29 audit found the sibling class.
sh_test(
    name = "doc_self_reference_test",
    size = "small",
    srcs = ["//tools:check-doc-self-references.sh"],
    data = _ARCHITECTURE_INPUTS + glob([
        "Packs/*/README.md",
        "Packs/*/skills/*/SKILL.md",
    ]),
)

# The public CLI is intentionally usable without an installed agent skill. This compact shell
# contract catches a regression that would otherwise leave humans and harnesses with only an
# undiscoverable tool implementation.
sh_test(
    name = "axon_cli_test",
    size = "small",
    srcs = ["//tools:axon.test.sh"],
    data = [
        "axon",
        "//tools:axon-context",
    ],
)

# One bun version, three files. repositories.bzl is the declared source of truth and
# nothing enforced it, so a bump could leave the other two behind with CI green (#40).
# The workflow is named explicitly because .github/ is outside every glob in this file
# -- which is exactly why the gate did not already exist.
sh_test(
    name = "bun_pin_equality_test",
    size = "small",
    srcs = ["//tools:check-bun-pin.sh"],
    data = [
        ".github/workflows/ci.yml",
        "upstreams.toml",
        "//tools/bazel/bun:repositories.bzl",
    ],
)

# Compatibility names for tests now owned by //tools. Existing CI commands and
# contributor muscle memory keep working, while each implementation and its
# runfiles are declared in the package that owns them.
alias(name = "agent_integrations_test", actual = "//tools:agent_integrations_test")
alias(name = "backup_test", actual = "//tools:backup_test")
alias(name = "bootstrap_test", actual = "//tools:bootstrap_test")
alias(name = "bun_pin_regression_test", actual = "//tools:bun_pin_regression_test")
alias(name = "doc_self_reference_regression_test", actual = "//tools:doc_self_reference_regression_test")
alias(name = "expiry_classification_test", actual = "//tools:expiry_classification_test")
alias(name = "external_ref_test", actual = "//tools:external_ref_test")
alias(name = "installed_probe_test", actual = "//tools:installed_probe_test")
alias(name = "lifeos_mirror_hook_test", actual = "//tools:lifeos_mirror_hook_test")
alias(name = "machine_resolution_test", actual = "//tools:machine_resolution_test")
alias(name = "manifest_resolution_test", actual = "//tools:manifest_resolution_test")
alias(name = "materialize_inference_key_test", actual = "//tools:materialize_inference_key_test")
alias(name = "publication_hygiene_test", actual = "//tools:publication_hygiene_test")
alias(name = "restore_test", actual = "//tools:restore_test")
alias(name = "update_profiles_test", actual = "//tools:update_profiles_test")
alias(name = "upstream_declaration_test", actual = "//tools:upstream_declaration_test")
alias(name = "version_compare_test", actual = "//tools:version_compare_test")

# tools/persistence-orphans.test.sh is deliberately NOT an sh_test. It runs the whole
# tools/doctor, which reads far more of the tree than a hermetic sandbox should have to
# declare — and under-declaring it does not fail loudly, it makes doctor's persistence check
# return early and the test pass over an empty report. That is the Axon#30 false-green shape
# again, so it runs in CI's `repo gates` job against a real checkout instead.

# Trivy itself owns vulnerability matching and expiry ENFORCEMENT. This test keeps the
# repository-specific contract honest: each service receives only its own reviewed policy,
# images with no accepted findings remain unfiltered, and every policy's date is reported
# before it lapses rather than after -- the scanners enforce silently, so nothing else in
# the system ever says a date is coming.
sh_test(
    name = "audit_policy_test",
    size = "small",
    srcs = ["//tools:audit.test.sh"],
    data = [
        "axon.toml",
        "//tools:audit",
        # expiry.sh because tools/audit sources it relative to itself on every path,
        # including the gitleaks-only one that skips the scanners entirely.
        "//tools:lib/expiry.sh",
        "//tools:lib/paths.sh",
        "//tools:lib/toml.sh",
    ] + glob([
        "capabilities/*/service.toml",
        "trivy-ignore/*.txt",
    ]),
)

# Capability-manifest schema + referential-integrity gates. Both scripts source
# tools/lib/paths.sh (which sources toml.sh and reads axon.toml's `overlay`), then read
# the manifests declared below. They run purely on files/dirs in the runfiles sandbox --
# no git, no wider checkout -- see each script's header. Shared input set:
_MANIFEST_INPUTS = [
    "axon.toml",  # explicit (non-empty anchor); paths.sh reads `overlay` from it, and
    # manifest_integrity reads its `capabilities = [...]` array.
    "//tools:lib/paths.sh",
    "//tools:lib/toml.sh",
    # check-service-tomls.sh sources this to validate a `schedule` duration with the same
    # parser service-runner.sh renders one with. Absent here, the gate dies in the sandbox on
    # a file that exists everywhere else -- the Axon#30 false-green class again.
    "//tools:lib/schedule.sh",
    # scouting/transit/axon-status are their own Bazel packages (own BUILD.bazel), so the
    # capabilities/*/README.md glob below can't reach them -- reference their README.md by
    # explicit cross-package label so those capability dirs still materialize in the sandbox
    # (manifest_integrity's dir-existence check needs every enabled capability's dir present).
    # Same reasoning as _ARCHITECTURE_INPUTS above.
    "//capabilities/comms:README.md",
    "//capabilities/scouting:README.md",
    "//capabilities/transit:README.md",
    "//capabilities/axon-status:README.md",
    "//capabilities/calendar:README.md",
    # Their service.toml files need the same treatment for the same reason: a glob in
    # this package cannot cross a package boundary, and a manifest the sandbox cannot
    # see is a manifest the gates silently never check.
    "//capabilities/comms:service.toml",
    "//capabilities/punctuality:service.toml",
    "//capabilities/scouting:service.toml",
    "//capabilities/transit:service.toml",
    "//capabilities/trips:service.toml",
    "//capabilities/axon-status:service.toml",
    "//capabilities/calendar:service.toml",
    "//capabilities/soundscape:service.toml",
    "//capabilities/tasks:service.toml",
    # The spine's own shell carries a manifest at the repo root (README.md#three-architectural-nouns). It used
    # to be a plain path because dashboard/ was part of THIS package; since it was wired
    # into the build graph it has its own BUILD.bazel, so it is a label like the rest.
    "//dashboard:service.toml",
] + glob([
    "capabilities/*/README.md",  # materializes every in-package capability dir in the sandbox
    "capabilities/*/service.toml",  # the files both gates actually parse
])
# allow_empty stays default-false (Bazel 9 disallows empty globs): >=1 service.toml and
# many README.md are committed, so neither pattern can be empty -- a future accidental wipe
# should fail loudly here, not slip through.

sh_test(
    name = "service_toml_schema_test",
    size = "small",
    srcs = ["//tools:check-service-tomls.sh"],
    data = _MANIFEST_INPUTS,
)

sh_test(
    name = "manifest_integrity_test",
    size = "small",
    srcs = ["//tools:check-manifest-integrity.sh"],
    data = _MANIFEST_INPUTS,
)
