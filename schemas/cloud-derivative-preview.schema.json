{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon.local/schemas/cloud-derivative-preview.schema.json",
  "title": "Axon Cloud Derivative Preview",
  "description": "A locally generated, bounded document that must be reviewed before it can be staged and queued for cloud processing.",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "id",
    "source_revision",
    "preview_hash",
    "original_data_class",
    "derivative_data_class",
    "transformation",
    "document",
    "redaction_count",
    "redactions",
    "entity_detection",
    "truncated",
    "approval_required",
    "provider_calls",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "cloud-derivative-preview-v1" },
    "source": { "enum": ["feed", "mail"] },
    "id": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "preview_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "original_data_class": { "enum": ["public", "personal", "vault"] },
    "derivative_data_class": { "enum": ["public", "personal"] },
    "transformation": { "enum": ["bounded-public-v1", "deterministic-entity-redaction-v2"] },
    "document": { "type": "string", "maxLength": 16000 },
    "redaction_count": { "type": "integer", "minimum": 0 },
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_type", "marker", "count"],
        "properties": {
          "entity_type": { "type": "string", "minLength": 1 },
          "marker": { "type": "string", "pattern": "^\\[.+\\]$" },
          "count": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "entity_detection": { "enum": ["not-required", "local-deterministic-v2"] },
    "truncated": { "type": "boolean" },
    "approval_required": { "const": true },
    "provider_calls": { "const": 0 },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
