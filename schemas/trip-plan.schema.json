{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon.local/schemas/trip-plan.schema.json",
  "title": "Axon Trip Plan",
  "type": "object",
  "required": [
    "id",
    "title",
    "origin",
    "destinations",
    "date_start",
    "date_end",
    "interests",
    "status",
    "travelers",
    "transport_modes",
    "stages",
    "cover_image_url",
    "source",
    "created_at",
    "updated_at",
    "items"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^trip:plan:" },
    "title": { "type": "string", "minLength": 1 },
    "origin": { "$ref": "#/$defs/placeRef" },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/placeRef" }
    },
    "date_start": { "type": "string", "format": "date" },
    "date_end": { "type": "string", "format": "date" },
    "interests": { "type": "string" },
    "status": { "enum": ["draft", "saved", "archived"] },
    "travelers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "transport_modes": {
      "type": "array",
      "items": { "$ref": "#/$defs/transportMode" },
      "uniqueItems": true
    },
    "stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/tripStage" }
    },
    "cover_image_url": { "type": ["string", "null"], "format": "uri" },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/planSource" },
        { "type": "null" }
      ]
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/planItem" }
    }
  },
  "$defs": {
    "placeRef": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["address", "airport", "city", "station", "venue"] },
        "address": { "type": ["string", "null"] },
        "latitude": { "type": ["number", "null"] },
        "longitude": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "transportMode": {
      "enum": ["bike", "bus", "car", "ferry", "flight", "train", "walk"]
    },
    "tripStage": {
      "type": "object",
      "required": [
        "id",
        "sequence",
        "origin",
        "destination",
        "date",
        "transport_modes",
        "travelers",
        "status",
        "selected_option_id"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^stage:" },
        "sequence": { "type": "integer", "minimum": 0 },
        "origin": { "$ref": "#/$defs/placeRef" },
        "destination": { "$ref": "#/$defs/placeRef" },
        "date": { "type": ["string", "null"], "format": "date" },
        "transport_modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/transportMode" },
          "uniqueItems": true
        },
        "travelers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "status": {
          "enum": ["planning", "option_selected", "booked", "completed"]
        },
        "selected_option_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "planSource": {
      "type": "object",
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "planItem": {
      "type": "object",
      "required": [
        "id",
        "plan_id",
        "item_type",
        "external_id",
        "title",
        "payload",
        "created_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^trip:item:" },
        "plan_id": { "type": "string", "pattern": "^trip:plan:" },
        "item_type": {
          "enum": [
            "journey",
            "transport",
            "event",
            "activity",
            "place",
            "stay",
            "image",
            "note"
          ]
        },
        "day": { "type": ["string", "null"], "format": "date" },
        "external_id": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" },
        "created_at": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
